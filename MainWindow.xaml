<Window x:Class="loginavicola.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModel="clr-namespace:loginavicola.ViewModel"
        xmlns:views="clr-namespace:loginavicola.View"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="1300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="Transparent"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#1B5E20" CornerRadius="6" Padding="10,6">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="White"
                                       FontSize="13"
                                       FontFamily="Segoe UI"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== -->
        <!-- ESTILOS DEL MENÚ - SIN LÍNEA AMARILLA -->
        <!-- ==================== -->
        <Style x:Key="menuButton" TargetType="RadioButton">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="8,2,8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="12,0"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="menuButtonIcon" TargetType="fa:IconImage">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Style x:Key="menuButtonText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ==================== -->
        <!-- ESTILOS DE BOTONES DE CONTROL -->
        <!-- ==================== -->
        <Style x:Key="controlButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" x:Name="bd">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="controlButtonIcon" TargetType="fa:IconImage">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
        </Style>

        <!-- ==================== -->
        <!-- ESTILO DEL POPUP      -->
        <!-- ==================== -->
        <Style x:Key="PopupMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ==================== -->
    <!-- CONTENEDOR PRINCIPAL  -->
    <!-- ==================== -->
    <Grid>
        <!-- ==================== -->
        <!-- VENTANA PRINCIPAL    -->
        <!-- ==================== -->
        <Border CornerRadius="10" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource winBorderColor1}" Offset="0"/>
                    <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.75"/>
                    <GradientStop Color="{StaticResource winBorderColor3}" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="250" MinWidth="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== -->
                <!-- SIDEBAR               -->
                <!-- ==================== -->
                <Border x:Name="SidebarBorder" CornerRadius="10,0,0,10" Grid.Column="0" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                            <GradientStop Color="{StaticResource primaryBackColor1}" Offset="0"/>
                            <GradientStop Color="{StaticResource primaryBackColor2}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <DockPanel LastChildFill="False">
                        <!-- ==================== -->
                        <!-- PARTE SUPERIOR        -->
                        <!-- ==================== -->
                        <StackPanel DockPanel.Dock="Top">
                            <!-- Fila: Hamburguesa + Logo -->
                            <Grid Height="95" Margin="12,10,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Botón Hamburguesa -->
                                <Button x:Name="btnHamburger"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Width="36" Height="36"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="btnHamburger_Click"
                                        ToolTip="Expandir / Colapsar menú">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" x:Name="btnBorder">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="btnBorder" Property="Background" Value="#33FFFFFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Rectangle Width="18" Height="2" Fill="White" RadiusX="1" RadiusY="1" Margin="0,0,0,4"/>
                                        <Rectangle Width="18" Height="2" Fill="White" RadiusX="1" RadiusY="1" Margin="0,0,0,4"/>
                                        <Rectangle Width="18" Height="2" Fill="White" RadiusX="1" RadiusY="1"/>
                                    </StackPanel>
                                </Button>

                                <!-- Logo SENA -->
                                <Image Grid.Column="1" 
                                       Source="/imagenes/logo-sena.png" 
                                       Height="115" 
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="18,10,10,10"/>
                            </Grid>

                            <!-- Título -->
                            <StackPanel x:Name="PanelLogo" Margin="12,8,12,48">
                                <TextBlock x:Name="TxtLogoNombre" 
                                           Text="Unidad Avícola Yamboró" 
                                           Foreground="White" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           FontFamily="Segoe UI" 
                                           TextWrapping="Wrap" 
                                           TextAlignment="Center"/>
                            </StackPanel>

                        </StackPanel>

                        <!-- ==================== -->
                        <!-- MENÚ DE NAVEGACIÓN    -->
                        <!-- ==================== -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,0">
                            <RadioButton x:Name="Btndashboar" Style="{StaticResource menuButton}" Tag="{StaticResource color1}" Click="Btndashboar_Click" IsChecked="True" ToolTip="Inicio" ToolTipService.Placement="Right">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="Home" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock x:Name="TxtInicio" Text="Inicio" Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="Btnlotes" Style="{StaticResource menuButton}" Tag="{StaticResource color1}" Click="Btnlotes_Click" ToolTip="Lotes" ToolTipService.Placement="Right">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="CheckToSlot" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock x:Name="TxtLotes" Text="Lotes" Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="BtnProduccion" Style="{StaticResource menuButton}" Tag="{StaticResource color1}" Click="BtnProduccion_Click" ToolTip="Producción" ToolTipService.Placement="Right">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="Egg" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock x:Name="TxtProduccion" Text="Producción" Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="Btnalimentacion" Style="{StaticResource menuButton}" Tag="{StaticResource color1}" Click="Btnalimentacion_Click" ToolTip="Alimentación" ToolTipService.Placement="Right">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="Jar" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock x:Name="TxtAlimentacion" Text="Alimentación" Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="Btndiagnostico" Style="{StaticResource menuButton}" Tag="{StaticResource color1}" Click="Btndiagnostico_Click" ToolTip="Diagnóstico" ToolTipService.Placement="Right">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="Stethoscope" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock x:Name="TxtDiagnostico" Text="Diagnóstico" Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="Btninventario" Style="{StaticResource menuButton}" Tag="{StaticResource color1}" Click="Btninventario_Click" ToolTip="Inventario" ToolTipService.Placement="Right">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="Warehouse" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock x:Name="TxtInventario" Text="Inventario" Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="Btngestion" Style="{StaticResource menuButton}" Tag="{StaticResource color1}" Click="Btngestion_Click" ToolTip="Gestión de usuarios" ToolTipService.Placement="Right">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="User" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock x:Name="TxtGestion" Text="Gestión de usuarios" Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="Btnreportes" Style="{StaticResource menuButton}" Tag="{StaticResource color1}" Click="Btnreportes_Click" ToolTip="Exportar Datos" ToolTipService.Placement="Right">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="Download" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock x:Name="TxtReportes" Text="Exportar Datos" Style="{StaticResource menuButtonText}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- ==================== -->
                        <!-- BOTÓN CERRAR SESIÓN   -->
                        <!-- ==================== -->
                        <Border DockPanel.Dock="Bottom" Background="Transparent" CornerRadius="8" Margin="10,10,10,15" Height="45">
                            <Button x:Name="btnVolverLogin" 
                                    HorizontalAlignment="Stretch" 
                                    VerticalAlignment="Stretch" 
                                    Background="#4CAF50" 
                                    BorderBrush="#A5D6A7" 
                                    BorderThickness="1" 
                                    Click="btnVolverLogin_Click" 
                                    Cursor="Hand" 
                                    ToolTip="Cerrar sesión">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                                            CornerRadius="10">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="ArrowRightFromBracket" Width="16" Height="16" Foreground="White" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtCerrarSesion" 
                                               Text="Cerrar sesión" 
                                               Foreground="White" 
                                               FontSize="14" 
                                               FontWeight="SemiBold" 
                                               VerticalAlignment="Center" 
                                               FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- ==================== -->
                <!-- CONTENIDO PRINCIPAL   -->
                <!-- ==================== -->
                <Border CornerRadius="0,10,10,0" Grid.Column="1" Background="#F0F2F5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="70"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ==================== -->
                        <!-- HEADER                -->
                        <!-- ==================== -->
                        <Grid Grid.Row="0">
                            <Grid.Background>
                                <SolidColorBrush Color="#388E3C"/>
                            </Grid.Background>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Título de la página -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="25,0,0,0">
                                <fa:IconImage x:Name="imgTitleIcon" Icon="Home" Height="22" Width="22" Foreground="White" Margin="0,0,12,0"/>
                                <TextBlock x:Name="txtWindowTitle" Text="Inicio" Foreground="White" FontSize="18" FontWeight="Medium" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </StackPanel>

                            <!-- Controles de ventana + Usuario con menú desplegable -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,25,0">

                                <!-- Info Usuario - Botón con menú desplegable -->
                                <Button x:Name="btnUserMenu" 
                                        Click="btnUserMenu_Click" 
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        Cursor="Hand" 
                                        Margin="0,0,20,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="8,4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#FFFFFF20"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Avatar con iniciales -->
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#4CAF50" Margin="0,0,10,0">
                                            <TextBlock x:Name="txtAvatarInicial" 
                                                       Text="A" 
                                                       Foreground="White" 
                                                       FontSize="16" 
                                                       FontWeight="Bold" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Nombre y chevron -->
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="txtUserName" 
                                                           Text="{Binding DisplayName}"
                                                           Foreground="White"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           FontFamily="Segoe UI"/>
                                                <fa:IconImage Icon="ChevronDown" Width="12" Height="12" Foreground="White" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>


                                <!-- Botones de control -->
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btnMinimizar" Style="{StaticResource controlButton}" Tag="{StaticResource color8}" Click="btnMinimize_Click" Margin="0,0,4,0">
                                        <fa:IconImage Icon="WindowMinimize" Width="12" Style="{StaticResource controlButtonIcon}"/>
                                    </Button>
                                    <Button x:Name="btnMaximize" Style="{StaticResource controlButton}" Tag="{StaticResource color6}" Click="btnMaximize_Click" Margin="0,0,4,0">
                                        <fa:IconImage Icon="Square" Style="{StaticResource controlButtonIcon}"/>
                                    </Button>
                                    <Button x:Name="btnClose" Style="{StaticResource controlButton}" Tag="{StaticResource color4}" Click="btnClose_Click">
                                        <fa:IconImage Icon="Xmark" Style="{StaticResource controlButtonIcon}"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- ==================== -->
                        <!-- CONTENIDO             -->
                        <!-- ==================== -->
                        <ContentControl x:Name="MainContentArea" Grid.Row="1" Margin="25"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== -->
        <!-- MENÚ DESPLEGABLE DEL USUARIO - SOLO NOMBRE Y ROL -->
        <!-- ==================== -->
        <Popup x:Name="popupUserMenu" 
               PlacementTarget="{Binding ElementName=btnUserMenu}" 
               Placement="Bottom" 
               StaysOpen="False" 
               AllowsTransparency="True" 
               Width="200"
               HorizontalOffset="-10">
            <Border Background="White" CornerRadius="8" Padding="12,10" BorderBrush="#E5E7EB" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="15" ShadowDepth="3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="popupUserName" 
                               Text="{Binding DisplayName}" 
                               FontWeight="SemiBold" 
                               FontSize="14" 
                               Foreground="#1F2937"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="popupUserRol" 
                               Text="{Binding DisplayRol}" 
                               FontSize="12" 
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>