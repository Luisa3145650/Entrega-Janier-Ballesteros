<UserControl x:Class="loginavicola.View.diagnosticoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:loginavicola.View"
             xmlns:helpers="clr-namespace:loginavicola.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             Background="Transparent"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <helpers:RoleToVisibilityConverter x:Key="RoleConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ESTILOS PARA TARJETAS -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="35"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="6,0,0,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO PARA BOTÓN VERDE -->
        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00872E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✚" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CAJA DE BÚSQUEDA -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ESTILOS PARA MODAL -->
        <Style x:Key="ModalTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00872E"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ModalButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTONES DE PAGINACIÓN -->
        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO PARA DATEPICKER EN MODAL -->
        <Style x:Key="ModalDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F1F5F9">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">

                <!-- TÍTULO SECCIÓN -->
                <StackPanel Margin="12,0,12,20">
                    <TextBlock Text="Control de Diagnóstico" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Monitoreo y seguimiento de diagnósticos médicos en las aves." FontSize="14" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- TARJETAS ESTADÍSTICAS -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" BorderBrush="#17A2B8">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TOTAL DIAGNÓSTICOS" FontSize="11" Foreground="#9CA3AF" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding TotalDiagnosticos, FallbackValue=0}" FontSize="36" FontWeight="Black" Foreground="#111827"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" BorderBrush="#9C59B6">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CASOS ACTIVOS" FontSize="11" Foreground="#9CA3AF" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding CasosActivos, FallbackValue=0}" FontSize="36" FontWeight="Black" Foreground="#111827"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" BorderBrush="#10B981">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CASOS RESUELTOS" FontSize="11" Foreground="#9CA3AF" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding CasosResueltos, FallbackValue=0}" FontSize="36" FontWeight="Black" Foreground="#111827"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource StatCardStyle}" BorderBrush="#F39C12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AVES AFECTADAS" FontSize="11" Foreground="#9CA3AF" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding AvesAfectadas, FallbackValue=0}" FontSize="36" FontWeight="Black" Foreground="#111827"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- BÚSQUEDA Y BOTÓN -->
                <Grid Margin="12,0,12,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="4" Margin="0,0,15,0" BorderBrush="#E5E7EB" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="12,0"/>
                            <TextBox Grid.Column="1" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource SearchBoxStyle}" FontSize="14" x:Name="SearchBox"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Content="REGISTRAR DIAGNÓSTICO" x:Name="BtnRegistrarDiagnostico" Click="BtnRegistrarDiagnostico_Click" Style="{StaticResource GreenButtonStyle}"/>
                </Grid>

                <!-- TABLA DE DATOS -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="12,0" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="2" Opacity="0.05" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Historial diagnóstico" FontSize="18" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,15"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Diagnosticos}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6" BorderThickness="0" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F9FAFB" RowHeight="40" MinHeight="300">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                    <Setter Property="Foreground" Value="#4B5563"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaDiagnostico, StringFormat=dd/MM/yyyy}" Width="100"/>
                                <DataGridTemplateColumn Header="Estado" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EF4444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Estado}" Value="Resuelto">
                                                                <Setter Property="Background" Value="#10B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Estado}" Foreground="White" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="110"/>
                                <DataGridTextColumn Header="Lote" Binding="{Binding IdLote}" Width="70"/>
                                <DataGridTextColumn Header="Cant. aves" Binding="{Binding GallinasAfectadas}" Width="90"/>
                                <DataGridTemplateColumn Header="Descripción" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DiagnosticoMedico}" TextWrapping="Wrap" MaxHeight="60" VerticalAlignment="Center" Margin="10,5"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tratamiento" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Tratamiento}" TextWrapping="Wrap" MaxHeight="60" VerticalAlignment="Center" Margin="10,5"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Medicamento" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NombreMedicamento}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,5" ToolTip="{Binding NombreMedicamento}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Cant. med." Binding="{Binding CantidadMedicamentoUsado}" Width="90"/>
                                <DataGridTextColumn Header="Veterinario" Binding="{Binding Veterinario}" Width="130"/>
                                <DataGridTemplateColumn Header="Observaciones" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Observaciones}" TextWrapping="Wrap" MaxHeight="60" VerticalAlignment="Center" Margin="10,5" ToolTip="{Binding Observaciones}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Acciones" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✓" Command="{Binding DataContext.MarcarComoResueltoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#10B981" Foreground="White" BorderThickness="0" Margin="2" Padding="8,4" Cursor="Hand" FontSize="12" ToolTip="Marcar como resuelto" Visibility="{Binding RelativeSource={RelativeSource Self}, Converter={StaticResource RoleConverter}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Estado}" Value="Resuelto">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="↺" Command="{Binding DataContext.ReabrirCasoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#F59E0B" Foreground="White" BorderThickness="0" Margin="2" Padding="8,4" Cursor="Hand" FontSize="12" ToolTip="Reabrir caso" Visibility="{Binding RelativeSource={RelativeSource Self}, Converter={StaticResource RoleConverter}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Estado}" Value="Resuelto">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="🗑️" Command="{Binding DataContext.EliminarDiagnosticoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#EF4444" Foreground="White" BorderThickness="0" Margin="2" Padding="8,4" Cursor="Hand" FontSize="12" ToolTip="Eliminar diagnóstico" Visibility="{Binding RelativeSource={RelativeSource Self}, Converter={StaticResource RoleConverter}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- PAGINACIÓN -->
                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Mostrar:" VerticalAlignment="Center" Foreground="#6B7280" FontSize="13" Margin="0,0,5,0"/>
                                <ComboBox Text="{Binding ElementosPorPagina, UpdateSourceTrigger=PropertyChanged}" Width="65" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="10" IsSelected="True"/>
                                    <ComboBoxItem Content="20"/>
                                    <ComboBoxItem Content="50"/>
                                </ComboBox>
                                <TextBlock Text="registros por página" VerticalAlignment="Center" Foreground="#6B7280" FontSize="13" Margin="5,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="◀" Command="{Binding PaginaAnteriorCommand}" Style="{StaticResource PagerButtonStyle}" Margin="0,0,5,0"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="Página " Foreground="#6B7280" FontSize="13"/>
                                    <TextBlock Text="{Binding PaginaActual, FallbackValue=1}" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                    <TextBlock Text=" de " Foreground="#6B7280" FontSize="13"/>
                                    <TextBlock Text="{Binding TotalPaginas, FallbackValue=1}" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                </StackPanel>
                                <Button Content="▶" Command="{Binding PaginaSiguienteCommand}" Style="{StaticResource PagerButtonStyle}" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- MODAL DE REGISTRO -->
        <Grid x:Name="ModalOverlay" Background="#70000000" Visibility="Collapsed" IsHitTestVisible="True">
            <Border Background="White" CornerRadius="20" MaxWidth="500" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Cabecera minimalista -->
                        <RowDefinition Height="*"/>
                        <!-- Formulario scrollable -->
                        <RowDefinition Height="Auto"/>
                        <!-- Botones finales -->
                    </Grid.RowDefinitions>

                    <!-- Cabecera -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Registro de Diagnóstico" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>

                        <Button Grid.Column="1" Content="✕" x:Name="BtnCerrarModal" Click="BtnCerrarModal_Click" 
                                Background="Transparent" Foreground="#94A3B8" BorderThickness="0" 
                                FontSize="18" FontWeight="SemiBold" Cursor="Hand" ToolTip="Cerrar">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Formulario -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0" Margin="0,0,-10,16">
                        <StackPanel>

                            <!-- Badge Verde Superior / ID del Lote o Registro -->
                            <Border Background="#ECFDF5" CornerRadius="10" Padding="14,10" Margin="0,0,0,18">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🩺" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ID Lote: " FontWeight="Bold" Foreground="#059669" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DiagnosticoActual.IdLote, FallbackValue='N/A'}" FontWeight="Bold" Foreground="#059669" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Campo: Fecha -->
                            <TextBlock Text="Fecha" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#475569"/>
                            <DatePicker SelectedDate="{Binding DiagnosticoActual.FechaDiagnostico}" Style="{StaticResource ModalDatePickerStyle}"/>

                            <!-- Campo: Tipo -->
                            <TextBlock Text="Tipo de Diagnóstico" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#475569"/>
                            <ComboBox ItemsSource="{Binding TiposDiagnostico}" SelectedItem="{Binding DiagnosticoActual.Tipo}" Style="{StaticResource ModalComboBoxStyle}"/>

                            <!-- Campo: Lote -->
                            <TextBlock Text="Lote Afectado" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#475569"/>
                            <ComboBox ItemsSource="{Binding LotesActivos}" DisplayMemberPath="IdLote" SelectedValuePath="IdLote" SelectedValue="{Binding DiagnosticoActual.IdLote}" Style="{StaticResource ModalComboBoxStyle}"/>

                            <!-- Campo: Descripción -->
                            <TextBlock Text="Descripción" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#475569"/>
                            <TextBox Text="{Binding DiagnosticoActual.DiagnosticoMedico}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModalTextBoxStyle}"/>

                            <!-- Campo: Tratamiento -->
                            <TextBlock Text="Tratamiento" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#475569"/>
                            <TextBox Text="{Binding DiagnosticoActual.Tratamiento}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModalTextBoxStyle}"/>

                            <!-- Campo: Medicamento -->
                            <TextBlock Text="Medicamento" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#475569"/>
                            <ComboBox ItemsSource="{Binding MedicamentosDisponibles}" DisplayMemberPath="Nombre" SelectedValuePath="IdItem" SelectedValue="{Binding DiagnosticoActual.IdMedicamento}" Style="{StaticResource ModalComboBoxStyle}"/>

                            <!-- Campos Fila Doble: Cant. Medicamento y Cant. Aves -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Cant. Medicamento" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#475569"/>
                                    <TextBox Text="{Binding DiagnosticoActual.CantidadMedicamentoUsado}" Style="{StaticResource ModalTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Aves Afectadas" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#475569"/>
                                    <TextBox Text="{Binding DiagnosticoActual.GallinasAfectadas}" Style="{StaticResource ModalTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Campo: Veterinario -->
                            <TextBlock Text="Veterinario a Cargo" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#475569"/>
                            <TextBox Text="{Binding DiagnosticoActual.Veterinario}" Style="{StaticResource ModalTextBoxStyle}"/>

                            <!-- Campo: Observaciones -->
                            <TextBlock Text="Observaciones" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#475569"/>
                            <TextBox Text="{Binding DiagnosticoActual.Observaciones}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModalTextBoxStyle}"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Acciones del modal (Botones estilo píldora/card) -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Guardar" x:Name="BtnGuardar" Click="BtnGuardar_Click" 
                                Height="42" Background="#059669" Foreground="White" FontWeight="Bold" FontSize="13" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="2" Content="Cancelar" x:Name="BtnCancelar" Click="BtnCerrarModal_Click" 
                                Height="42" Background="#CBD5E1" Foreground="#334155" FontWeight="SemiBold" FontSize="13" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>