<Window x:Class="loginavicola.View.ConfiguracionHardwareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de hardware" Height="380" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F1F5F9">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Configuración de hardware de este equipo"
                   FontSize="17" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="Elige el puerto de la báscula y la cámara conectados a este computador."
                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="2" Text="Puerto de la báscula:" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,4"/>
        <ComboBox x:Name="cmbPuertos" Grid.Row="3" Height="36" Margin="0,0,0,16"
                  DisplayMemberPath="Descripcion" SelectedValuePath="Puerto"/>

        <TextBlock Grid.Row="4" Text="Cámara:" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,4"/>
        <ComboBox x:Name="cmbCamaras" Grid.Row="5" Height="36" Margin="0,0,0,16"/>

        <TextBlock x:Name="txtEstado" Grid.Row="6" Text="Detectando dispositivos conectados..."
                   FontSize="12" Foreground="#64748B" VerticalAlignment="Top" TextWrapping="Wrap"/>

        <Grid Grid.Row="7" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnDetectar" Grid.Column="0" Content="🔄 Detectar de nuevo"
                    HorizontalAlignment="Left" Height="34" Padding="14,0" Background="#1E293B" Foreground="White" BorderThickness="0"/>

            <Button x:Name="btnCancelar" Grid.Column="1" Content="Cancelar"
                    Height="34" Padding="14,0" Margin="0,0,8,0" Background="#E2E8F0" Foreground="#1E293B" BorderThickness="0"/>

            <Button x:Name="btnGuardar" Grid.Column="2" Content="Guardar y continuar"
                    Height="34" Padding="14,0" Background="#39A900" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
