<Window x:Class="loginavicola.View.loginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:loginavicola.View"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        Title="loginView" Height="550" Width="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Border CornerRadius="12" ClipToBounds="True">
        <!-- IMAGEN: Opacidad cambiada de 0.6 a 0.9 -->
        <Border.Background>
            <ImageBrush ImageSource="/loginavicola;component/imagenes/gallinas.jpg">
                <ImageBrush.Opacity>
                    0.9
                </ImageBrush.Opacity>
            </ImageBrush>
        </Border.Background>

        <Border CornerRadius="12" 
                BorderThickness="2"
                ClipToBounds="True"
                Opacity="0.60">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource winBorderColor1}"  Offset="0"/>
                    <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.75"/>
                    <GradientStop Color="{StaticResource  winBorderColor3}" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <!-- CAPA NEGRA: Color cambiado de CC a E6 (más opaco) -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Color="#E6000000" Offset="0"/>
                    <GradientStop Color="#E6000000" Offset="0.75"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="5"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="LOGIN"
                               Foreground="DarkGray"
                               FontSize="10"
                               FontFamily="Arial"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                    <Button x:Name="btnMinimize"
                            BorderThickness="0"
                            Content="-"
                            Foreground="White"
                            FontSize="26"
                            FontFamily="Arial"
                            Cursor="Hand"
                            Grid.Column="1"
                            Click="btnMinimize_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#28AEED"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="Blue"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Width="18" Height="18"
                                        CornerRadius="9"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,-6,0,0"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>

                    <Button x:Name="btnClose"
                            BorderThickness="0"
                            Content="X"
                            Foreground="White"
                            FontSize="12"
                            FontFamily="Arial"
                            Cursor="Hand"
                            Grid.Column="2"
                            Click="btnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#DA34"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="Red"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Width="18" Height="18"
                                        CornerRadius="9"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>

                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- FORMULARIO: NO SE TOCA, QUEDA IGUAL -->
                <Border Width="300"
                        Background="#4DFFFFFF"
                        CornerRadius="20"
                        Margin="171,15,137,15"
                        Grid.RowSpan="2">

                    <StackPanel Orientation="Vertical">

                        <Image Source="/imagenes/logo-sena.png"
                               Width="100" Height="100"/>

                        <TextBlock Text="Unidad Avicola Yamboró"
                                   Foreground="White"
                                   FontSize="19"
                                   FontWeight="Medium" 
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Bienvenido a la unidad avicola de Yamboró"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Medium" 
                                   FontFamily="Arial"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,5,15,0"/>
                        <!-- ================= USUARIO ================= -->
                        <TextBlock Text="Usuario"
           TextWrapping="Wrap"
           Foreground="White"
           FontSize="12"
           FontWeight="Medium" 
           FontFamily="Arial"
           Margin="10,35,0,0"/>

                        <Grid Margin="10,5,15,0">
                            <TextBox x:Name="txtUser"
             FontSize="13"
             FontWeight="Medium"
             FontFamily="Arial" 
             Foreground="White"
             CaretBrush="White"
             BorderBrush="White"
             BorderThickness="0,0,0,1"
             Height="28"
             VerticalContentAlignment="Center"
             Padding="28,0,0,0"
             Background="Transparent"/>

                            <!-- Icono de FontAwesome para Usuario -->
                            <fa:IconImage Icon="User" 
                  Foreground="White" 
                  Width="14" Height="14" 
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Center" 
                  Margin="5,0,0,0"/>
                        </Grid>


                        <!-- ================= CONTRASEÑA (CON ESPACIO EXTRA) ================= -->
                        <!-- El truco está aquí: Margin="10,25,0,0" (Cambiamos de 10 a 25 en el margen superior) -->
                        <TextBlock Text="Contraseña"
           Foreground="White"
           FontSize="12"
           FontWeight="Medium" 
           FontFamily="Arial"
           TextWrapping="Wrap"
           Margin="10,25,0,0"/>

                        <Grid Margin="10,5,15,0">
                            <PasswordBox x:Name="txtPassword"
                 FontSize="13"
                 FontWeight="Medium"
                 FontFamily="Arial" 
                 Foreground="White"
                 CaretBrush="White"
                 BorderBrush="White"
                 BorderThickness="0,0,0,1"
                 Height="28"
                 VerticalContentAlignment="Center"
                 Padding="28,0,0,0"
                 Background="Transparent"/>

                            <!-- Icono de FontAwesome para la LLAVE (Key) -->
                            <fa:IconImage Icon="Key" 
                  Foreground="White" 
                  Width="14" Height="14" 
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Center" 
                  Margin="5,0,0,0"/>
                        </Grid>

                        <Button x:Name="btnLogin"
                                BorderThickness="0"
                                Content="Iniciar sesion"
                                Foreground="White"
                                FontSize="12"
                                FontFamily="Arial"
                                Cursor="Hand"
                                Margin="0,50,0,0"
                                Click="BtnLogin_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#007B00"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#005E00"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Width="150" Height="40"
                                            CornerRadius="20"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"
                                                          HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Botón de Visitante -->
                        <Button x:Name="btnVisitante"
                                BorderThickness="0"
                                Content="Entrar como visitante"
                                Foreground="White"
                                FontSize="12"
                                FontFamily="Arial"
                                Cursor="Hand"
                                Margin="0,15,0,20"
                                Click="BtnVisitante_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#007B00"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#005E00"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Width="150" Height="40"
                                            CornerRadius="20"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"
                                                          HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>