<UserControl x:Class="loginavicola.View.gestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:loginavicola.View"
             xmlns:helpers="clr-namespace:loginavicola.Helpers"
             mc:Ignorable="d" 
             FontFamily="Segoe UI"
             d:DesignHeight="850" d:DesignWidth="1100"
             Background="#F0F2F5">

    <UserControl.Resources>
        <helpers:RoleToVisibilityConverter x:Key="RoleConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:RolColorConverter x:Key="RolColorConverter"/>

        <!-- ========================================= -->
        <!-- ESTILOS PARA TARJETAS                     -->
        <!-- ========================================= -->

        <!-- Base para tarjetas de usuario -->
        <Style x:Key="UserCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,24,20,20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="270"/>
            <Setter Property="BorderThickness" Value="6,0,0,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.12" Color="#000000"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ========================================= -->
        <!-- ESTILOS PARA BOTONES                      -->
        <!-- ========================================= -->

        <!-- Botón de acción principal (verde) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✚" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón de configuración de permisos -->
        <Style x:Key="PermisosButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10B981"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#10B981"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ========================================= -->
        <!-- ESTILOS PARA MODAL                        -->
        <!-- ========================================= -->

        <Style x:Key="ModalTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ModalComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ModalButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para Toggle Switch (CheckBox) -->
        <Style x:Key="ModernToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid x:Name="ToggleTrack" Width="44" Height="24" Margin="0,0,10,0">
                                <Border Background="#CBD5E1" CornerRadius="12" x:Name="TrackBorder"/>
                                <Ellipse x:Name="Thumb" Fill="White" Width="18" Height="18" HorizontalAlignment="Left" Margin="3,0" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.2"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TrackBorder" Property="Background" Value="#10B981"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F0F2F5">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">

                <!-- ==================== -->
                <!-- TÍTULO SECCIÓN       -->
                <!-- ==================== -->
                <Grid Margin="12,0,12,20">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Control de Personal" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Administra accesos, roles y permisos de la Unidad Avícola." FontSize="14" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Content="✚ NUEVO USUARIO" 
                            x:Name="BtnAgregarUsuario"
                            Click="BtnAgregarUsuario_Click"
                            Style="{StaticResource BotonPrimarioSENA}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- ==================== -->
                <!-- TARJETAS DE USUARIOS  -->
                <!-- ==================== -->
                <ItemsControl ItemsSource="{Binding Usuarios}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource UserCardStyle}" 
                                    BorderBrush="{Binding Rol, Converter={StaticResource RolColorConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Avatar -->
                                    <Border Grid.Row="0" Width="70" Height="70" CornerRadius="35" 
                                            Background="{Binding Rol, Converter={StaticResource RolColorConverter}, ConverterParameter=Background}" 
                                            HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="👤" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Detalles -->
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding NombreCompleto}" FontSize="15" FontWeight="Bold" Foreground="#111827" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                                        <Border CornerRadius="12" Padding="12,5" Margin="0,10,0,0" HorizontalAlignment="Center" 
                                                Background="{Binding Rol, Converter={StaticResource RolColorConverter}}">
                                            <TextBlock Text="{Binding Rol}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Botón de Permisos -->
                                    <Button Grid.Row="2" Content="⚙️ Ajustes de Permisos" 
                                            Click="BtnGestionarPermisos_Click"
                                            Tag="{Binding}"
                                            Style="{StaticResource PermisosButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,8,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ==================== -->
        <!-- MODAL: REGISTRO DE USUARIO (ESTANDARIZADO) -->
        <!-- ==================== -->
        <Grid x:Name="ModalRegistroOverlay" Background="#80000000" Visibility="Collapsed" IsHitTestVisible="True">
            <Border Background="White" CornerRadius="8" MaxWidth="560" MaxHeight="720" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.2" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera del modal -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Registro de Usuario" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="30,25,20,15" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" x:Name="BtnCerrarModalRegistro" Click="BtnCerrarModalRegistro_Click" Background="Transparent" Foreground="#64748B" BorderThickness="0" FontSize="16" FontWeight="Bold" Padding="15,10" Margin="15,15,20,0" Cursor="Hand" ToolTip="Cerrar"/>
                    </Grid>

                    <!-- Formulario -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,5,30,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Nombres" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding UsuarioActual.Nombres}" Style="{StaticResource ModalTextBoxStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Apellidos" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding UsuarioActual.Apellidos}" Style="{StaticResource ModalTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Documento de Identidad" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding UsuarioActual.Documento}" Style="{StaticResource ModalTextBoxStyle}"/>

                            <TextBlock Text="Número de Teléfono" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding UsuarioActual.Telefono}" Style="{StaticResource ModalTextBoxStyle}"/>

                            <TextBlock Text="Dirección de Residencia" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding UsuarioActual.Direccion}" Style="{StaticResource ModalTextBoxStyle}"/>

                            <TextBlock Text="Correo Electrónico" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding UsuarioActual.Email}" Style="{StaticResource ModalTextBoxStyle}"/>

                            <TextBlock Text="Asignación de Rol" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding UsuarioActual.Rol, Mode=TwoWay}" Style="{StaticResource ModalComboBoxStyle}">
                                <ComboBoxItem Content="Administrador"/>
                                <ComboBoxItem Content="Usuario"/>
                                <ComboBoxItem Content="Visitante"/>
                            </ComboBox>

                            <TextBlock Text="Contraseña del Sistema" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModalPasswordBoxStyle}"/>

                            <TextBlock Text="Confirmar Contraseña" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource ModalPasswordBoxStyle}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Acciones del modal (Botones a la derecha: Guardar SENA + Cancelar gris) -->
                    <Border Grid.Row="2" Padding="30,15,30,25" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar" x:Name="BtnCancelarRegistro" Click="BtnCerrarModalRegistro_Click" Style="{StaticResource ModalButtonStyle}" Background="#E2E8F0" Foreground="#475569" Margin="0,0,12,0"/>
                            <Button Content="Guardar" x:Name="BtnGuardarUsuario" Click="BtnGuardarUsuario_Click" Style="{StaticResource ModalButtonStyle}" Background="#39A900" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== -->
        <!-- MODAL: PANEL DE PERMISOS -->
        <!-- ==================== -->
        <Grid x:Name="ModalPermisosOverlay" Background="#80000000" Visibility="Collapsed" IsHitTestVisible="True">
            <Border Background="White" CornerRadius="12" MaxWidth="550" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#10B981">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="20,12">
                            <TextBlock Text="Configuración de Accesos" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Activa o desactiva los módulos permitidos." FontSize="11" Foreground="White" Opacity="0.8" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" x:Name="BtnCerrarModalPermisos" Click="BtnCerrarModalPermisos_Click" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="18" FontWeight="Bold" Padding="15,10" Cursor="Hand" ToolTip="Cerrar"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
                        <UniformGrid Columns="2" VerticalAlignment="Top">
                            <!-- Permisos -->
                            <Border Background="#F8FAFC" CornerRadius="8" Padding="14,12" Margin="6" BorderBrush="#E5E7EB" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoInicio}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Inicio" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                        <TextBlock Text="Panel principal" Foreground="#6B7280" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Background="#F8FAFC" CornerRadius="8" Padding="14,12" Margin="6" BorderBrush="#E5E7EB" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoLotes}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Lotes" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                        <TextBlock Text="Control de galpones" Foreground="#6B7280" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Background="#F8FAFC" CornerRadius="8" Padding="14,12" Margin="6" BorderBrush="#E5E7EB" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoProduccion}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Producción" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                        <TextBlock Text="Registro de huevos" Foreground="#6B7280" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Background="#F8FAFC" CornerRadius="8" Padding="14,12" Margin="6" BorderBrush="#E5E7EB" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoAlimentacion}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Alimentación" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                        <TextBlock Text="Suministro de concentrado" Foreground="#6B7280" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Background="#F8FAFC" CornerRadius="8" Padding="14,12" Margin="6" BorderBrush="#E5E7EB" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoEntregas}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Entregas" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                        <TextBlock Text="Salida de pedidos" Foreground="#6B7280" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Background="#F8FAFC" CornerRadius="8" Padding="14,12" Margin="6" BorderBrush="#E5E7EB" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoDiagnostico}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Diagnóstico" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                        <TextBlock Text="Estado sanitario" Foreground="#6B7280" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Background="#F8FAFC" CornerRadius="8" Padding="14,12" Margin="6" BorderBrush="#E5E7EB" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoInventario}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Inventario" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                        <TextBlock Text="Insumos y stock" Foreground="#6B7280" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Background="#F8FAFC" CornerRadius="8" Padding="14,12" Margin="6" BorderBrush="#E5E7EB" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoGestionUsuarios}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Usuarios" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                        <TextBlock Text="Asignar credenciales" Foreground="#6B7280" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </UniformGrid>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB" Padding="30,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="APLICAR CAMBIOS" x:Name="BtnGuardarPermisos" Click="BtnGuardarPermisos_Click" Style="{StaticResource ModalButtonStyle}" Background="#10B981" Foreground="White"/>
                            <Button Grid.Column="2" Content="DESCARTAR" x:Name="BtnCancelarPermisos" Click="BtnCerrarModalPermisos_Click" Style="{StaticResource ModalButtonStyle}" Background="#E5E7EB" Foreground="#374151"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>