<UserControl x:Class="loginavicola.View.gestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:loginavicola.View"
             xmlns:helpers="clr-namespace:loginavicola.Helpers"
             mc:Ignorable="d" 
             FontFamily="Segoe UI"
             d:DesignHeight="850" d:DesignWidth="1100"
             Background="#F0F2F5">

    <UserControl.Resources>
        <helpers:RoleToVisibilityConverter x:Key="RoleConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:RolColorConverter x:Key="RolColorConverter"/>

        <!-- ========================================= -->
        <!-- ESTILOS PARA TARJETAS                     -->
        <!-- ========================================= -->
        <Style x:Key="UserCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,24,20,20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="270"/>
            <Setter Property="BorderThickness" Value="6,0,0,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.12" Color="#000000"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ========================================= -->
        <!-- ESTILOS PARA BOTONES DE LA VISTA         -->
        <!-- ========================================= -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00872E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✚" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PermisosButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10B981"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#10B981"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ========================================= -->
        <!-- ESTILOS REDISEÑADOS PARA MODAL (IMAGEN)   -->
        <!-- ========================================= -->

        <!-- Inputs suaves y redondeados -->
        <Style x:Key="ModalInputStyle" TargetType="Control">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox estilo Modal (con dropdown funcional) -->
        <Style x:Key="ModalComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="border" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"/>

                            <!-- Texto del item seleccionado -->
                            <ContentPresenter Grid.Column="0"
                                               Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center"
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                               IsHitTestVisible="False"/>

                            <!-- Flechita -->
                            <TextBlock Grid.Column="1" Text="▾" FontSize="12" Foreground="#64748B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>

                            <!-- Área clickeable que abre el desplegable -->
                            <ToggleButton x:Name="ToggleButton" Grid.ColumnSpan="2"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Popup con la lista de items -->
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="8" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.15"/>
                                    </Border.Effect>
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón Guardar (Verde) -->
        <Style x:Key="ModalPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00A86B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón Cancelar (Gris) -->
        <Style x:Key="ModalSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch para Permisos -->
        <Style x:Key="ModernToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid x:Name="ToggleTrack" Width="44" Height="24" Margin="0,0,10,0">
                                <Border Background="#CBD5E1" CornerRadius="12" x:Name="TrackBorder"/>
                                <Ellipse x:Name="Thumb" Fill="White" Width="18" Height="18" HorizontalAlignment="Left" Margin="3,0" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.2"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TrackBorder" Property="Background" Value="#10B981"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F0F2F5">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">

                <!-- ==================== -->
                <!-- TÍTULO SECCIÓN       -->
                <!-- ==================== -->
                <Grid Margin="12,0,12,20">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Control de Personal" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Administra accesos, roles y permisos de la Unidad Avícola." FontSize="14" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Content="NUEVO USUARIO" 
                            x:Name="BtnAgregarUsuario"
                            Click="BtnAgregarUsuario_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- ==================== -->
                <!-- TARJETAS DE USUARIOS  -->
                <!-- ==================== -->
                <ItemsControl ItemsSource="{Binding Usuarios}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource UserCardStyle}" 
                                    BorderBrush="{Binding Rol, Converter={StaticResource RolColorConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Avatar -->
                                    <Border Grid.Row="0" Width="70" Height="70" CornerRadius="35" 
                                            Background="{Binding Rol, Converter={StaticResource RolColorConverter}, ConverterParameter=Background}" 
                                            HorizontalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="👤" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Detalles -->
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding NombreCompleto}" FontSize="15" FontWeight="Bold" Foreground="#111827" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                                        <Border CornerRadius="12" Padding="12,5" Margin="0,10,0,0" HorizontalAlignment="Center" 
                                                Background="{Binding Rol, Converter={StaticResource RolColorConverter}}">
                                            <TextBlock Text="{Binding Rol}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Botón de Permisos -->
                                    <Button Grid.Row="2" Content="⚙️ Ajustes de Permisos" 
                                            Click="BtnGestionarPermisos_Click"
                                            Tag="{Binding}"
                                            Style="{StaticResource PermisosButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,8,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ========================================= -->
        <!-- MODAL: REGISTRO/EDICIÓN (ESTILO IMAGEN)   -->
        <!-- ========================================= -->
        <Grid x:Name="ModalRegistroOverlay" Background="#66000000" Visibility="Collapsed" IsHitTestVisible="True">
            <Border Background="White" CornerRadius="24" Width="480" MaxHeight="720" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.15" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ENCABEZADO -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Registro de Usuario" FontSize="22" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" x:Name="BtnCerrarModalRegistro" Click="BtnCerrarModalRegistro_Click" 
                                Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="18" FontWeight="Bold" Cursor="Hand"/>
                    </Grid>

                    <!-- FORMULARIO -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-10,16" Padding="0,0,10,0">
                        <StackPanel>
                            <!-- Badge verde estilo ID -->
                            <Border Background="#ECFDF5" CornerRadius="12" Padding="14,10" Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ID Usuario: 0" FontSize="13" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Nombres" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding UsuarioActual.Nombres}" Style="{StaticResource ModalInputStyle}"/>

                            <TextBlock Text="Apellidos" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding UsuarioActual.Apellidos}" Style="{StaticResource ModalInputStyle}"/>

                            <TextBlock Text="Documento de Identidad" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding UsuarioActual.Documento}" Style="{StaticResource ModalInputStyle}"/>

                            <TextBlock Text="Número de Teléfono" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding UsuarioActual.Telefono}" Style="{StaticResource ModalInputStyle}"/>

                            <TextBlock Text="Correo Electrónico" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding UsuarioActual.Email}" Style="{StaticResource ModalInputStyle}"/>

                            <TextBlock Text="Asignación de Rol" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding UsuarioActual.Rol, Mode=TwoWay}" Style="{StaticResource ModalComboBoxStyle}">
                                <ComboBoxItem Content="Administrador"/>
                                <ComboBoxItem Content="Usuario"/>
                            </ComboBox>

                            <TextBlock Text="Contraseña del Sistema" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModalInputStyle}"/>

                            <TextBlock Text="Confirmar Contraseña" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource ModalInputStyle}"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- BOTONES INFERIORES -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Guardar" x:Name="BtnGuardarUsuario" Click="BtnGuardarUsuario_Click" Style="{StaticResource ModalPrimaryButtonStyle}"/>
                        <Button Grid.Column="2" Content="Cancelar" x:Name="BtnCancelarRegistro" Click="BtnCerrarModalRegistro_Click" Style="{StaticResource ModalSecondaryButtonStyle}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== -->
        <!-- MODAL: PANEL DE PERMISOS -->
        <!-- ==================== -->
        <Grid x:Name="ModalPermisosOverlay" Background="#66000000" Visibility="Collapsed" IsHitTestVisible="True">
            <Border Background="White" CornerRadius="20" MaxWidth="520" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Configuración de Accesos" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="Activa o desactiva los módulos permitidos." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" x:Name="BtnCerrarModalPermisos" Click="BtnCerrarModalPermisos_Click" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="18" FontWeight="Bold" Cursor="Hand"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,8">
                        <UniformGrid Columns="2" VerticalAlignment="Top">
                            <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoInicio}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Inicio" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                        <TextBlock Text="Panel principal" Foreground="#6B7280" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoLotes}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Lotes" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                        <TextBlock Text="Control de galpones" Foreground="#6B7280" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoProduccion}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Producción" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                        <TextBlock Text="Registro de huevos" Foreground="#6B7280" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoAlimentacion}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Alimentación" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                        <TextBlock Text="Suministro de concentrado" Foreground="#6B7280" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoReportes}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Exportar Datos" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                        <TextBlock Text="Descarga de reportes" Foreground="#6B7280" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoDiagnostico}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Diagnóstico" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                        <TextBlock Text="Estado sanitario" Foreground="#6B7280" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoInventario}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Inventario" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                        <TextBlock Text="Insumos y stock" Foreground="#6B7280" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Background="#F8FAFC" CornerRadius="10" Padding="12" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoGestionUsuarios}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Usuarios" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                        <TextBlock Text="Asignar credenciales" Foreground="#6B7280" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </UniformGrid>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Aplicar" x:Name="BtnGuardarPermisos" Click="BtnGuardarPermisos_Click" Style="{StaticResource ModalPrimaryButtonStyle}"/>
                        <Button Grid.Column="2" Content="Descartar" x:Name="BtnCancelarPermisos" Click="BtnCerrarModalPermisos_Click" Style="{StaticResource ModalSecondaryButtonStyle}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
