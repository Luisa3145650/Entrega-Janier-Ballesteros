<Window x:Class="loginavicola.View.AlertasModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Alertas del Sistema" Height="520" Width="680"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Border Background="White" CornerRadius="16" BorderBrush="#CBD5E1" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Color="#0F172A" Direction="270" Opacity="0.15" ShadowDepth="6"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔔 Alertas del Sistema" FontSize="20" FontWeight="Bold" Foreground="#0F172A" FontFamily="Segoe UI"/>
                    <Border Background="#FEE2E2" CornerRadius="12" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtContadorAlertas" Text="0 Alertas Activas" FontSize="12" FontWeight="Bold" Foreground="#DC2626"/>
                    </Border>
                </StackPanel>

                <Button x:Name="btnCerrarX" Content="✕" FontSize="16" FontWeight="Bold" Foreground="#64748B"
                        Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Cursor="Hand" Click="btnCerrar_Click"/>
            </Grid>

            <!-- Lista de Alertas -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <ItemsControl x:Name="icAlertas">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding FondoSeveridad}" BorderBrush="{Binding ColorSeveridad}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icono -->
                                    <TextBlock Grid.Column="0" Text="{Binding IconoSeveridad}" FontSize="22" VerticalAlignment="Top" Margin="0,2,12,0"/>

                                    <!-- Detalle -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Titulo}" FontSize="15" FontWeight="Bold" Foreground="{Binding ColorSeveridad}"/>
                                        <TextBlock Text="{Binding Mensaje}" FontSize="13" Foreground="#1E293B" Margin="0,2,0,4" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DetalleExtra}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Botón Entendido / Cerrar -->
            <Button Grid.Row="2" Content="Entendido" Width="120" Height="36" HorizontalAlignment="Right"
                    Background="#0F172A" Foreground="White" FontWeight="Bold" FontSize="13"
                    BorderThickness="0" Cursor="Hand" Click="btnCerrar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
