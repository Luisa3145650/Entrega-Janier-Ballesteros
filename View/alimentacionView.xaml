<UserControl x:Class="loginavicola.View.alimentacionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:loginavicola.View"
             xmlns:helpers="clr-namespace:loginavicola.Helpers"
             xmlns:root="clr-namespace:loginavicola"
             mc:Ignorable="d" 
             FontFamily="Segoe UI"
             d:DesignHeight="819" d:DesignWidth="1207">

    <UserControl.Resources>
        <helpers:RoleToVisibilityConverter x:Key="RoleConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ========================================= -->
        <!-- ESTILOS PARA TARJETAS (IGUAL QUE INVENTARIO) -->
        <!-- ========================================= -->

        <!-- Base para todas las tarjetas - IGUAL que en inventarioView -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="35,35,35,35"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="BorderThickness" Value="6,0,0,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO PARA BOTÓN VERDE (IGUAL que inventarioView) -->
        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00872E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✚" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CAJA DE BÚSQUEDA (IGUAL que inventarioView) -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ESTILOS PARA MODAL (IGUAL que inventarioView) -->
        <Style x:Key="ModalTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ModalComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ModalButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTONES DE PAGINACIÓN -->
        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para DatePicker -->
        <Style x:Key="ModalDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F0F2F5">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">

                <!-- ==================== -->
                <!-- TÍTULO SECCIÓN       -->
                <!-- ==================== -->
                <StackPanel Margin="12,0,12,20">
                    <TextBlock Text="Control de Alimentación" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Administra el consumo diario, semanal e inventario disponible de alimento." FontSize="14" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- ==================== -->
                <!-- TARJETAS ESTADÍSTICAS -->
                <!-- ==================== -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tarjeta 1: CONSUMO ESTIMADO (Amarilla) -->
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" BorderBrush="#FACC15">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CONSUMO ESTIMADO / AVE" FontSize="11" Foreground="#9CA3AF" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="120 kg" FontSize="36" FontWeight="Black" Foreground="#111827"/>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta 2: CONSUMO SEMANAL (Azul) -->
                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" BorderBrush="#3B82F6">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CONSUMO SEMANAL" FontSize="11" Foreground="#9CA3AF" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding ConsumoSemanal, FallbackValue='0 Kg'}" FontSize="36" FontWeight="Black" Foreground="#111827"/>
                        </StackPanel>
                    </Border>

                    <!-- Tarjeta 3: ALIMENTO DISPONIBLE (Morada) -->
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" BorderBrush="#A855F7">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ALIMENTO DISPONIBLE" FontSize="11" Foreground="#9CA3AF" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding AlimentoDisponible, FallbackValue='159'}" FontSize="36" FontWeight="Black" Foreground="#111827"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ==================== -->
                <!-- BÚSQUEDA Y BOTÓN     -->
                <!-- ==================== -->
                <Grid Margin="12,0,12,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="4" Margin="0,0,15,0" BorderBrush="#E5E7EB" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="12,0"/>
                            <TextBox Grid.Column="1" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource SearchBoxStyle}" FontSize="14"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Content="REGISTRAR CONSUMO" Click="BtnRegistrarConsumo_Click" Style="{StaticResource GreenButtonStyle}"/>
                </Grid>

                <!-- ==================== -->
                <!-- TABLA DE DATOS       -->
                <!-- ==================== -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="12,0" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="2" Opacity="0.05" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Historial de Consumo" FontSize="18" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,15"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Consumos}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6" BorderThickness="0" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F9FAFB" RowHeight="40" MinHeight="250">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                    <Setter Property="Foreground" Value="#4B5563"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID consumo/Fecha" Binding="{Binding FechaConsumo, StringFormat=dd/MM/yyyy}" Width="160"/>
                                <DataGridTextColumn Header="Lote" Binding="{Binding IdLoteGallinas}" Width="100"/>
                                <DataGridTextColumn Header="Alimento" Binding="{Binding NombreAlimento}" Width="150"/>
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadConsumida}" Width="100"/>
                                <DataGridTextColumn Header="Unidad" Binding="{Binding UnidadMedida}" Width="90"/>
                                <DataGridTextColumn Header="Turno" Binding="{Binding Turno}" Width="90"/>
                                <DataGridTextColumn Header="Observaciones" Binding="{Binding Observaciones}" Width="*"/>
                                <DataGridTemplateColumn Header="Acciones" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✏️" Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#E3F2FD" BorderThickness="0" Margin="2" Padding="8,4" Cursor="Hand" Visibility="{Binding RelativeSource={RelativeSource Self}, Converter={StaticResource RoleConverter}}" ToolTip="Editar consumo"/>
                                                <Button Content="🗑️" Command="{Binding DataContext.EliminarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#FFEBEE" BorderThickness="0" Margin="2" Padding="8,4" Cursor="Hand" Visibility="{Binding RelativeSource={RelativeSource Self}, Converter={StaticResource RoleConverter}}" ToolTip="Eliminar consumo"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- ==================== -->
                        <!-- PAGINACIÓN           -->
                        <!-- ==================== -->
                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Mostrar:" VerticalAlignment="Center" Foreground="#6B7280" FontSize="13" Margin="0,0,5,0"/>
                                <ComboBox SelectedValue="{Binding ElementosPorPagina, Mode=TwoWay}" Width="65" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                                    <System:Int32 xmlns:System="clr-namespace:System;assembly=mscorlib">5</System:Int32>
                                    <System:Int32 xmlns:System="clr-namespace:System;assembly=mscorlib">10</System:Int32>
                                    <System:Int32 xmlns:System="clr-namespace:System;assembly=mscorlib">20</System:Int32>
                                </ComboBox>
                                <TextBlock Text="registros por página" VerticalAlignment="Center" Foreground="#6B7280" FontSize="13" Margin="5,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="◀" Command="{Binding PaginaAnteriorCommand}" Style="{StaticResource PagerButtonStyle}" Margin="0,0,5,0"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="Página " Foreground="#6B7280" FontSize="13"/>
                                    <TextBlock Text="{Binding PaginaActual, FallbackValue=1}" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                    <TextBlock Text=" de " Foreground="#6B7280" FontSize="13"/>
                                    <TextBlock Text="{Binding TotalPaginas, FallbackValue=1}" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                </StackPanel>
                                <Button Content="▶" Command="{Binding PaginaSiguienteCommand}" Style="{StaticResource PagerButtonStyle}" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>


        <!-- ==================== -->
        <!-- MODAL DE REGISTRO / EDICIÓN (ESTILO MODERNO) -->
        <!-- ==================== -->
        <Grid x:Name="ModalOverlay" 
      Background="#80000000" 
      Visibility="Collapsed" 
      IsHitTestVisible="True">

            <Border Background="White" 
            CornerRadius="20" 
            Width="460" 
            MaxHeight="680" 
            VerticalAlignment="Center" 
            HorizontalAlignment="Center" 
            Margin="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.25" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Cabecera -->
                        <RowDefinition Height="*"/>
                        <!-- Formulario scrolleable -->
                        <RowDefinition Height="Auto"/>
                        <!-- Botones de Acción -->
                    </Grid.RowDefinitions>

                    <!-- 1. Cabecera del Submodal -->
                    <Grid Grid.Row="0" Margin="28,24,28,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                           Text="Registro de Consumo" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="#1E293B" 
                           VerticalAlignment="Center"/>

                        <Button Grid.Column="1" 
                        Content="✕" 
                        Click="BtnCerrarModal_Click" 
                        Background="Transparent" 
                        Foreground="#94A3B8" 
                        BorderThickness="0" 
                        FontSize="18" 
                        FontWeight="SemiBold" 
                        Cursor="Hand" 
                        ToolTip="Cerrar"/>
                    </Grid>

                    <!-- 2. Formulario en Scroll -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,28,10">
                        <StackPanel>

                            <!-- Indicador Consumo Activo / Badge Verde -->
                            <Border Background="#ECFDF5" CornerRadius="12" Padding="14,12" Margin="0,0,0,18">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌾" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ConsumoActual.IdConsumo, StringFormat='ID Consumo: {0}', FallbackValue='Nuevo Registro'}" 
                                       Foreground="#047857" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Campo: Fecha -->
                            <TextBlock Text="Fecha" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding ConsumoActual.FechaConsumo}" 
                                Height="42" 
                                Background="#F8FAFC" 
                                BorderBrush="#E2E8F0" 
                                BorderThickness="1" 
                                Margin="0,0,0,16" 
                                VerticalContentAlignment="Center"/>

                            <!-- Campo: Lote -->
                            <TextBlock Text="Lote" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding LotesActivos}" 
                              DisplayMemberPath="IdLote" 
                              SelectedValuePath="IdLote" 
                              SelectedValue="{Binding ConsumoActual.IdLoteGallinas}" 
                              Height="42" 
                              Background="#F8FAFC" 
                              BorderBrush="#E2E8F0" 
                              BorderThickness="1" 
                              Margin="0,0,0,16" 
                              VerticalContentAlignment="Center"/>

                            <!-- Campo: Alimento -->
                            <TextBlock Text="Alimento" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Alimentos}" 
                              DisplayMemberPath="Nombre" 
                              SelectedItem="{Binding AlimentoSeleccionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              Height="42" 
                              Background="#F8FAFC" 
                              BorderBrush="#E2E8F0" 
                              BorderThickness="1" 
                              Margin="0,0,0,16" 
                              VerticalContentAlignment="Center"/>

                            <!-- Filas combinadas: Cantidad y Unidad -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Cantidad -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Cantidad" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                                        <TextBox Text="{Binding ConsumoActual.CantidadConsumida}" 
                                         Padding="12,10" 
                                         BorderThickness="0" 
                                         Background="Transparent" 
                                         FontSize="13" 
                                         Foreground="#0F172A"/>
                                    </Border>
                                </StackPanel>

                                <!-- Unidad -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Unidad" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding UnidadesMedida}" 
                                      SelectedItem="{Binding ConsumoActual.UnidadMedida}" 
                                      Height="42" 
                                      Background="#F8FAFC" 
                                      BorderBrush="#E2E8F0" 
                                      BorderThickness="1" 
                                      VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Campo: Turno -->
                            <TextBlock Text="Turno" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Turnos}" 
                              SelectedItem="{Binding ConsumoActual.Turno}" 
                              Height="42" 
                              Background="#F8FAFC" 
                              BorderBrush="#E2E8F0" 
                              BorderThickness="1" 
                              Margin="0,0,0,16" 
                              VerticalContentAlignment="Center"/>

                            <!-- Campo: Observaciones -->
                            <TextBlock Text="Observaciones" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                                <TextBox Text="{Binding ConsumoActual.Observaciones}" 
                                 Height="75" 
                                 Padding="12,10" 
                                 BorderThickness="0" 
                                 Background="Transparent" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto" 
                                 FontSize="13" 
                                 Foreground="#0F172A"/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- 3. Botones Inferiores -->
                    <Grid Grid.Row="2" Margin="28,10,28,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Botón Guardar (Verde Redondeado) -->
                        <Button Grid.Column="0" 
                        Content="Guardar" 
                        Click="BtnGuardar_Click" 
                        Height="44" 
                        Background="#059669" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        FontSize="14" 
                        Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Botón Cancelar (Gris Redondeado) -->
                        <Button Grid.Column="2" 
                        Content="Cancelar" 
                        Click="BtnCerrarModal_Click" 
                        Height="44" 
                        Background="#CBD5E1" 
                        Foreground="#334155" 
                        FontWeight="Bold" 
                        FontSize="14" 
                        Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>