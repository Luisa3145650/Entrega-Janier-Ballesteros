<UserControl x:Class="loginavicola.View.homeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             x:Name="RootView"
             FontFamily="Segoe UI"
             d:DesignHeight="600" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- ========================================= -->
        <!-- ESTILOS PARA TARJETAS ESTADÍSTICAS        -->
        <!-- ========================================= -->

        <!-- Base para todas las tarjetas (igual que en inventarioView) -->
        <Style x:Key="StatCardBaseStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="25,25,25,25"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="MinHeight" Value="120"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="6,0,0,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta: TOTAL GALLINAS (Amarilla) -->
        <Style x:Key="CardGallinasStyle" TargetType="Border" BasedOn="{StaticResource StatCardBaseStyle}">
            <Setter Property="BorderBrush" Value="#FACC15"/>
        </Style>

        <!-- Tarjeta: HUEVOS HOY (Azul) -->
        <Style x:Key="CardHuevosStyle" TargetType="Border" BasedOn="{StaticResource StatCardBaseStyle}">
            <Setter Property="BorderBrush" Value="#3B82F6"/>
        </Style>

        <!-- Tarjeta: STOCK ALIMENTO (Morada) -->
        <Style x:Key="CardAlimentoStyle" TargetType="Border" BasedOn="{StaticResource StatCardBaseStyle}">
            <Setter Property="BorderBrush" Value="#A855F7"/>
        </Style>

        <!-- Tarjeta: ALERTAS STOCK (Roja con fondo de alerta) -->
        <Style x:Key="CardAlertasStyle" TargetType="Border" BasedOn="{StaticResource StatCardBaseStyle}">
            <Setter Property="BorderBrush" Value="#EF4444"/>
            <Setter Property="Background" Value="#FEF2F2"/>
        </Style>

        <!-- Estilo para el título de las tarjetas -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Estilo para el valor principal -->
        <Style x:Key="BigValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <!-- Estilo para unidades (Kg) -->
        <Style x:Key="ValueUnitStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <!-- Estilo para el badge de alerta -->
        <Style x:Key="AlertBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== -->
        <!-- HEADER               -->
        <!-- ==================== -->
        <Grid Grid.Row="0" Margin="20,10,20,0">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Panel de Control General" 
                           FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="Monitoreo de producción y analíticas de Yamboró." 
                           FontSize="14" Foreground="#6B7280" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ==================== -->
        <!-- TARJETAS ESTADÍSTICAS -->
        <!-- ==================== -->
        <Grid Grid.Row="1" Margin="20,24,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tarjeta 1: TOTAL GALLINAS -->
            <Border Grid.Column="0" Style="{StaticResource CardGallinasStyle}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TOTAL GALLINAS" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="TotalGallinasValue" 
                               Text="{Binding TotalAves, StringFormat={}{0:N0}}" 
                               Style="{StaticResource BigValueStyle}"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 2: HUEVOS HOY -->
            <Border Grid.Column="1" Style="{StaticResource CardHuevosStyle}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="HUEVOS HOY" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock x:Name="HuevosHoyValue" 
                               Text="{Binding TotalHuevosHoy, StringFormat={}{0:N0}}" 
                               Style="{StaticResource BigValueStyle}"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 3: STOCK ALIMENTO -->
            <Border Grid.Column="2" Style="{StaticResource CardAlimentoStyle}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="STOCK ALIMENTO" Style="{StaticResource CardTitleStyle}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AlimentoValue" 
                                   Text="{Binding TotalAlimento, StringFormat={}{0:N0}}" 
                                   Style="{StaticResource BigValueStyle}"/>
                        <TextBlock Text="Kg" Style="{StaticResource ValueUnitStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tarjeta 4: ALERTAS STOCK (con badge de alerta) -->
            <Border Grid.Column="3" Style="{StaticResource CardAlertasStyle}" Cursor="Hand" ToolTip="Ver detalle de alertas de stock crítico">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding FiltrarAlertasCommand}"/>
                </Border.InputBindings>
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ALERTAS STOCK (&lt; MIN)" 
                                   Style="{StaticResource CardTitleStyle}" 
                                   Foreground="#DC2626"/>
                        <TextBlock x:Name="LotesValue" 
                                   Text="{Binding TotalAlertasStock, FallbackValue=0}" 
                                   Style="{StaticResource BigValueStyle}" 
                                   Foreground="#DC2626"/>
                    </StackPanel>
                    <!-- Badge de alerta -->
                    <Border Style="{StaticResource AlertBadgeStyle}">
                        <TextBlock Text="⚠" Foreground="#EF4444" FontSize="16" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== -->
        <!-- GRÁFICAS / CARRUSEL  -->
        <!-- ==================== -->
        <Grid Grid.Row="2" Margin="20,16,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>

                <!-- Botón Anterior -->
                <Button x:Name="btnAnterior" 
                        Grid.Column="0"
                        Width="45" Height="45"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Cursor="Hand"
                        Click="BtnAnterior_Click"
                        Visibility="Collapsed">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#10B981" CornerRadius="22.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
                                </Border.Effect>
                                <TextBlock Text="◀" FontSize="20" Foreground="White" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Contenedor del carrusel -->
                <Border x:Name="CarruselContainer" 
                        Grid.Column="1"
                        Background="White" 
                        CornerRadius="12" 
                        Padding="30,24"
                        Margin="10,0"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="2" 
                                          Opacity="0.05" Color="#000000"/>
                    </Border.Effect>

                    <Grid x:Name="CarruselContent">
                        <TextBlock Text="Sección de Gráficas" FontSize="18" FontWeight="Medium" 
                                   Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Botón Siguiente -->
                <Button x:Name="btnSiguiente" 
                        Grid.Column="2"
                        Width="45" Height="45"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Cursor="Hand"
                        Click="BtnSiguiente_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#10B981" CornerRadius="22.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
                                </Border.Effect>
                                <TextBlock Text="▶" FontSize="20" Foreground="White" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Indicadores del carrusel -->
            <StackPanel Grid.Row="1" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,20,0,0">
                <Border x:Name="Indicator0" Width="40" Height="6" CornerRadius="3" 
                        Background="#10B981" Margin="6,0" Cursor="Hand"/>
                <Border x:Name="Indicator1" Width="40" Height="6" CornerRadius="3" 
                        Background="#D1D5DB" Margin="6,0" Cursor="Hand"/>
                <Border x:Name="Indicator2" Width="40" Height="6" CornerRadius="3" 
                        Background="#D1D5DB" Margin="6,0" Cursor="Hand"/>
                <Border x:Name="Indicator3" Width="40" Height="6" CornerRadius="3" 
                        Background="#D1D5DB" Margin="6,0" Cursor="Hand"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>