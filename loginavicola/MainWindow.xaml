<Window x:Class="loginavicola.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModel="clr-namespace:loginavicola.ViewModel"
        xmlns:views="clr-namespace:loginavicola.View"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        xmlns:view="clr-namespace:loginavicola.View"
        Title="MainWindow" Height="700" Width="1300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="Transparent"
        AllowsTransparency="True">

    <Border CornerRadius="10" 
            BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource winBorderColor1}"  Offset="0"/>
                <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.75"/>
                <GradientStop Color="{StaticResource  winBorderColor3}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="10,0,0,0"
                    Grid.Column="0">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                        <GradientStop Color="{StaticResource primaryBackColor1}" Offset="0"/>
                        <GradientStop Color="{StaticResource primaryBackColor2}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Vertical"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                            <Image Source="/imagenes/logo-sena.png" Height="68" HorizontalAlignment="Center"/>
                            <TextBlock Text="Unidad Avícola Yamboró"
                               Foreground="White"
                               FontSize="16"
                               FontFamily="Arial"
                               HorizontalAlignment="Center"
                               Margin="0,5,20,30"/>
                        </StackPanel>
                    </Grid>

                    <RadioButton x:Name="Btndashboar" Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color1}"
                                 Click="Btndashboar_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Home" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Inicio" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="Btnlotes" Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color1}"
                                 Click="Btnlotes_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="CheckToSlot" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Lotes" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="BtnProduccion" Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color1}"
                                 Click="BtnProduccion_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="egg" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Producción" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="Btnalimentacion" Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color1}"
                                 Click="Btnalimentacion_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Jar" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Alimentación" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="Btnventa" Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color1}"
                                 Click="Btnventa_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="MagnifyingGlass" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Entregas" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="Btndiagnostico" Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color1}"
                                 Click="Btndiagnostico_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Stethoscope" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Diagnostico" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="Btninventario" Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color1}"
                                 Click="Btninventario_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Warehouse" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Inventario" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="Btngestion" Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color1}"
                                 Click="Btngestion_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="User" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Gestión de usuarios" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="Btnreportes" Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color1}"
                                 Click="Btnreportes_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Download" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Exportar Datos" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <Border Background="#E74C3C" 
                            CornerRadius="8" 
                            Margin="15,190,15,15"
                            Padding="0"
                            Height="45">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                        </Border.Effect>

                        <Button x:Name="btnVolverLogin"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="btnVolverLogin_Click"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#C0392B"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <fa:IconImage Icon="ArrowRightFromBracket" Width="16" Height="16" Foreground="White" Margin="0,0,10,0"/>
                                <TextBlock Text="Cerrar sesión" Foreground="White" FontSize="13" FontWeight="SemiBold" FontFamily="Arial" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>
            </Border>

            <Border CornerRadius="0,10,10,0" Grid.Column="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                        <GradientStop Color="{StaticResource secondaryBackColor2}" Offset="0"/>
                        <GradientStop Color="{StaticResource primaryBackColor2}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="43*"/>
                        <ColumnDefinition Width="219*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="pnlControlBar" MouseEnter="pnlControlBar_MouseEnter" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft" Background="Transparent" HorizontalAlignment="Right" Margin="0,0,5,0" MouseLeftButtonDown="pnlControlBar_MouseLeftButtonDown" >
                        <Button x:Name="btnClose" Style="{StaticResource controlButton}" Tag="{StaticResource color4}" Click="btnClose_Click">
                            <fa:IconImage Icon="Xmark" Style="{StaticResource controlButtonIcon}"/>
                        </Button>
                        <Button x:Name="btnMaximize" Style="{StaticResource controlButton}" Tag="{StaticResource color6}" Click="btnMaximize_Click">
                            <fa:IconImage Icon="Square" Style="{StaticResource controlButtonIcon}"/>
                        </Button>
                        <Button x:Name="btnMinimizar" Style="{StaticResource controlButton}" Tag="{StaticResource color8}" Click="btnMinimize_Click">
                            <fa:IconImage Icon="WindowMinimize" Width="12" Style="{StaticResource controlButtonIcon}"/>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <fa:IconImage x:Name="imgTitleIcon" Icon="home" Height="20" Width="20" Foreground="{StaticResource titleColor2}" Margin="35,0,10,0"/>
                            <TextBlock x:Name="txtWindowTitle" Text="Dashboard" Foreground="{StaticResource titleColor2}" FontSize="16" FontFamily="Arial" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Button Style="{StaticResource iconButton}" Tag="{StaticResource color1}">
                                <fa:IconImage Icon="AngleDown" Height="12" Width="12" Style="{StaticResource iconButtonIcon}"/>
                            </Button>
                            <TextBlock Text="{Binding CurrentUserAccount.Nombre}" Foreground="{StaticResource titleColor3}" FontFamily="Arial" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Ellipse Height="35" Width="35" Stroke="{StaticResource color2}" Margin="10,0,10,0">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="/imagenes/user_icon.png"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Button Style="{StaticResource iconButton}" Tag="{StaticResource color3}">
                                <fa:IconImage Icon="Clock" Style="{StaticResource iconButtonIcon}"/>
                            </Button>
                            <Button Style="{StaticResource iconButton}" Tag="{StaticResource color4}">
                                <fa:IconImage Icon="Envelope" Style="{StaticResource iconButtonIcon}"/>
                            </Button>
                            <Button Style="{StaticResource iconButton}" Tag="{StaticResource color5}">
                                <fa:IconImage Icon="Bell" Style="{StaticResource iconButtonIcon}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ContentControl x:Name="MainContentArea" Grid.Row="2" Margin="25" Grid.ColumnSpan="2"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>