<UserControl x:Class="loginavicola.View.inventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:loginavicola.Helpers"
             xmlns:local="clr-namespace:loginavicola.View"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1000"
             Background="Transparent"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <helpers:RoleToVisibilityConverter x:Key="RoleConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="35,35,35,35"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="BorderThickness" Value="6,0,0,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✚" FontSize="14" FontWeight="Bold" 
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter HorizontalAlignment="Center" 
                                                 VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModalButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                             VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ModalComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30">

                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" BorderBrush="#FACC15">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TOTAL PRODUCTOS" FontSize="11" Foreground="#9CA3AF" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding TotalProductos, FallbackValue=0}" FontSize="36" FontWeight="Black" Foreground="#111827"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#FEF2F2" CornerRadius="10" Margin="10" BorderThickness="6,0,0,0" BorderBrush="#EF4444" Padding="15">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="STOCK BAJO" FontSize="11" Foreground="#DC2626" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding StockBajo, FallbackValue=0}" FontSize="36" FontWeight="Black" Foreground="#DC2626"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#FEE2E2" Width="32" Height="32" CornerRadius="8" VerticalAlignment="Top">
                                <TextBlock Text="⚠" Foreground="#EF4444" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" BorderBrush="#A855F7">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="STOCK ÓPTIMO" FontSize="11" Foreground="#9CA3AF" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding StockOptimo, FallbackValue=0}" FontSize="36" FontWeight="Black" Foreground="#111827"/>
                        </StackPanel>
                    </Border>

                    
                </Grid>
                <Grid Margin="10,0,10,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="4" Margin="0,0,15,0" BorderBrush="#E5E7EB" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="12,0"/>
                            <TextBox Grid.Column="1" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource SearchBoxStyle}" x:Name="SearchBox" FontSize="14"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Content="REGISTRAR PRODUCTO" x:Name="BtnRegistrarProducto" Click="BtnRegistrarProducto_Click" Style="{StaticResource GreenButtonStyle}"/>
                </Grid>

                <Border Background="White" CornerRadius="12" Padding="20" Margin="10,0" BorderBrush="#E5E7EB" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="2" Opacity="0.05" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Inventario Actual" FontSize="18" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,15"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding ItemsInventario}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F3F4F6" BorderThickness="0" Background="Transparent" RowBackground="White" AlternatingRowBackground="#F9FAFB" RowHeight="40" MinHeight="300">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                    <Setter Property="Foreground" Value="#4B5563"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID producto" Binding="{Binding IdItem}" Width="100"/>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="150"/>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="120"/>
                                <DataGridTextColumn Header="Costo unitario" Binding="{Binding CostoUnitario, StringFormat=C}" Width="110"/>
                                <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="100"/>
                                <DataGridTextColumn Header="Fecha caducidad" Binding="{Binding FechaCaducidad, StringFormat=dd/MM/yyyy}" Width="120"/>
                                <DataGridTextColumn Header="Stock mínimo" Binding="{Binding StockMinimo}" Width="100"/>
                                <DataGridTextColumn Header="Stock máximo" Binding="{Binding StockMaximo}" Width="100"/>
                                <DataGridTextColumn Header="Stock actual" Binding="{Binding CantidadStock}" Width="100"/>
                                <DataGridTextColumn Header="Observaciones" Binding="{Binding Observaciones}" Width="200"/>
                                <DataGridTemplateColumn Header="Acciones" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✏️" Command="{Binding DataContext.EditarItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#E3F2FD" BorderThickness="0" Margin="2" Padding="8,4" Cursor="Hand" Visibility="{Binding RelativeSource={RelativeSource Self}, Converter={StaticResource RoleConverter}}" ToolTip="Editar producto" Click="BtnEditar_Click"/>
                                                <Button Content="🗑️" Command="{Binding DataContext.EliminarItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#FFEBEE" BorderThickness="0" Margin="2" Padding="8,4" Cursor="Hand" Visibility="{Binding RelativeSource={RelativeSource Self}, Converter={StaticResource RoleConverter}}" ToolTip="Eliminar producto"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="White" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB" Padding="25,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Mostrar:" VerticalAlignment="Center" Foreground="#6B7280" Margin="0,0,5,0" FontSize="13"/>
                    <ComboBox ItemsSource="{Binding OpcionesTamanoPagina}" SelectedItem="{Binding TamanoPagina}" Width="65" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    <TextBlock Text="registros por página" VerticalAlignment="Center" Foreground="#6B7280" Margin="5,0,0,0" FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="◀" Command="{Binding PaginaAnteriorCommand}" Background="#E5E7EB" BorderThickness="0" Padding="12,6" Margin="0,0,5,0" Cursor="Hand" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="Página " Foreground="#6B7280" FontSize="13"/>
                        <TextBlock Text="{Binding PaginaActual, FallbackValue=1}" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                        <TextBlock Text=" de " Foreground="#6B7280" FontSize="13"/>
                        <TextBlock Text="{Binding TotalPaginas, FallbackValue=1}" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                    </StackPanel>
                    <Button Content="▶" Command="{Binding PaginaSiguienteCommand}" Background="#E5E7EB" BorderThickness="0" Padding="12,6" Margin="5,0,0,0" Cursor="Hand" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ModalOverlay" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed" IsHitTestVisible="True">
            <Border Background="White" CornerRadius="12" MaxWidth="550" MaxHeight="700" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="#10B981">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Registro de Producto" FontSize="16" FontWeight="Bold" Foreground="White" Margin="20,15" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" x:Name="BtnCerrarModal" Click="BtnCerrarModal_Click" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="18" FontWeight="Bold" Padding="15,10" Cursor="Hand" ToolTip="Cerrar"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,20" Margin="0,10">
                        <StackPanel>
                            <TextBlock Text="ID producto" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#374151"/>
                            <TextBox Text="{Binding ItemActual.IdItem}" Style="{StaticResource ModalTextBoxStyle}"/>

                            <TextBlock Text="Nombre" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#374151"/>
                            <TextBox Text="{Binding ItemActual.Nombre}" Style="{StaticResource ModalTextBoxStyle}"/>

                            <TextBlock Text="Categoría" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#374151"/>
                            <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding ItemActual.Categoria}" Style="{StaticResource ModalComboBoxStyle}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Padding" Value="10,8"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <TextBlock Text="Costo unitario" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#374151"/>
                            <TextBox Text="{Binding ItemActual.CostoUnitario}" Style="{StaticResource ModalTextBoxStyle}"/>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ubicación" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#374151"/>
                                    <TextBox Text="{Binding ItemActual.Ubicacion}" Padding="10,8" BorderBrush="#E5E7EB" BorderThickness="1"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Fecha caducidad" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#374151"/>
                                    <DatePicker SelectedDate="{Binding ItemActual.FechaCaducidad}" Padding="6,6" BorderBrush="#E5E7EB" BorderThickness="1"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Stock mínimo" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#374151"/>
                                    <TextBox Text="{Binding ItemActual.StockMinimo}" Padding="10,8" BorderBrush="#E5E7EB" BorderThickness="1"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Stock máximo" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#374151"/>
                                    <TextBox Text="{Binding ItemActual.StockMaximo}" Padding="10,8" BorderBrush="#E5E7EB" BorderThickness="1"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Stock actual" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#374151"/>
                            <TextBox Text="{Binding ItemActual.CantidadStock}" Style="{StaticResource ModalTextBoxStyle}"/>

                            <TextBlock Text="Observaciones" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5" Foreground="#374151"/>
                            <TextBox Text="{Binding ItemActual.Observaciones}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="10,8" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,15"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB" Padding="30,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="GUARDAR" x:Name="BtnGuardar" Click="BtnGuardar_Click" Style="{StaticResource ModalButtonStyle}" Background="#10B981" Foreground="White"/>
                            <Button Grid.Column="2" Content="CANCELAR" x:Name="BtnCancelar" Click="BtnCerrarModal_Click" Style="{StaticResource ModalButtonStyle}" Background="#E5E7EB" Foreground="#374151"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>