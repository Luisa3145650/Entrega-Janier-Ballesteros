<UserControl x:Class="loginavicola.View.produccionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:loginavicola.View"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Height" Value="130"/>
            <Setter Property="Width" Value="300"/>
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style x:Key="InfoButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#17A2B8"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#DC3545"/>
        </Style>

        <Style x:Key="GrayButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#6C757D"/>
        </Style>

        <Style x:Key="PurpleButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#6F42C1"/>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Border Style="{StaticResource StatCardStyle}" Background="#FFC107">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="0" FontSize="32" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Producción Hoy" FontSize="12" Foreground="White" Opacity="0.9"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="12" Width="50" Height="50" VerticalAlignment="Center">
                            <TextBlock Text="🥚" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource StatCardStyle}" Background="#9C27B0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="0" FontSize="32" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Lotes activos" FontSize="12" Foreground="White" Opacity="0.9"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="12" Width="50" Height="50" VerticalAlignment="Center">
                            <TextBlock Text="📦" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource StatCardStyle}" Background="#17A2B8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="0%" FontSize="32" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Eficiencia" FontSize="12" Foreground="White" Opacity="0.9"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="12" Width="50" Height="50" VerticalAlignment="Center">
                            <TextBlock Text="✓" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="600"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="CÁMARA" FontSize="14" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>
                        <TextBlock Text="Integrar" FontSize="11" Foreground="#666" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="cbCamaras" Grid.Column="0" DisplayMemberPath="Nombre" Style="{StaticResource ComboBoxStyle}" Height="36" VerticalContentAlignment="Center" Margin="0,0,8,0"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="btnConectarCamara" Content="▶" ToolTip="Conectar" Style="{StaticResource InfoButtonStyle}" Width="36" Height="36" Padding="0" FontSize="12" Margin="0,0,4,0"/>
                                <Button x:Name="btnDesconectarCamara" Content="⏹" ToolTip="Desconectar" Style="{StaticResource DangerButtonStyle}" Width="36" Height="36" Padding="0" FontSize="12" Margin="0,0,4,0"/>
                                <Button x:Name="btnRefrescarCamaras" Content="🔄" ToolTip="Buscar cámaras" Style="{StaticResource GrayButtonStyle}" Width="36" Height="36" Padding="0" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="#DDDDDD" BorderThickness="1" Background="Black" Height="450" CornerRadius="8" Margin="0,0,0,10">
                            <Image x:Name="imgCamara" Stretch="Uniform"/>
                        </Border>

                        <Button x:Name="btnCapturarFoto" Content="Capturar foto" Style="{StaticResource PurpleButtonStyle}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtEstadoCamara" Text="2 cámara(s) detectada(s)" FontSize="11" Foreground="#666" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="RESUMEN DE PRODUCCIÓN" FontSize="14" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Detalles por Categoría:" FontSize="12" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,10"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <Rectangle Width="12" Height="12" Fill="#00BCD4" Margin="0,0,10,0"/>
                                            <TextBlock Text="Jumbo" Width="80" Foreground="#333" FontSize="11"/>
                                            <TextBlock x:Name="lblResumenJumbo" Text="0" Foreground="#666" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <Rectangle Width="12" Height="12" Fill="#2196F3" Margin="0,0,10,0"/>
                                            <TextBlock Text="AAA" Width="80" Foreground="#333" FontSize="11"/>
                                            <TextBlock x:Name="lblResumenAAA" Text="0" Foreground="#666" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <Rectangle Width="12" Height="12" Fill="#FFC107" Margin="0,0,10,0"/>
                                            <TextBlock Text="AA" Width="80" Foreground="#333" FontSize="11"/>
                                            <TextBlock x:Name="lblResumenAA" Text="0" Foreground="#666" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <Rectangle Width="12" Height="12" Fill="#4CAF50" Margin="0,0,10,0"/>
                                            <TextBlock Text="A" Width="80" Foreground="#333" FontSize="11"/>
                                            <TextBlock x:Name="lblResumenA" Text="0" Foreground="#666" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <Rectangle Width="12" Height="12" Fill="#FF9800" Margin="0,0,10,0"/>
                                            <TextBlock Text="B" Width="80" Foreground="#333" FontSize="11"/>
                                            <TextBlock x:Name="lblResumenB" Text="0" Foreground="#666" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <Rectangle Width="12" Height="12" Fill="#F44336" Margin="0,0,10,0"/>
                                            <TextBlock Text="C" Width="80" Foreground="#333" FontSize="11"/>
                                            <TextBlock x:Name="lblResumenC" Text="0" Foreground="#666" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                    <TextBlock Text="Estadísticas:" FontSize="12" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,10"/>
                                    <StackPanel Margin="0,5">
                                        <TextBlock Text="Total" FontSize="11" Foreground="#666"/>
                                        <TextBlock x:Name="lblTotalResumen" Text="0" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,15,0,0">
                                        <TextBlock Text="Peso Promedio" FontSize="11" Foreground="#666"/>
                                        <TextBlock x:Name="lblPesoPromedio" Text="0 g" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="HISTORIAL RECIENTE" FontSize="14" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>
                            <DataGrid x:Name="dgHistorial" AutoGenerateColumns="False" Background="Transparent" Foreground="#333" BorderBrush="#DDDDDD" BorderThickness="1" HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True" Height="180" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F0F0" SelectionChanged="dgHistorial_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="90"/>
                                    <DataGridTextColumn Header="Hora" Binding="{Binding Hora, StringFormat=hh\\:mm\\:ss}" Width="80"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding TipoClasificacion}" Width="90"/>
                                    <DataGridTextColumn Header="Recolector" Binding="{Binding Recolector}" Width="120"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="60"/>
                                    <DataGridTextColumn Header="Jumbo" Binding="{Binding Jumbo}" Width="60"/>
                                    <DataGridTextColumn Header="AAA" Binding="{Binding AAA}" Width="50"/>
                                    <DataGridTextColumn Header="AA" Binding="{Binding AA}" Width="50"/>
                                    <DataGridTextColumn Header="A" Binding="{Binding A}" Width="50"/>
                                    <DataGridTextColumn Header="B" Binding="{Binding B}" Width="50"/>
                                    <DataGridTextColumn Header="C" Binding="{Binding C}" Width="50"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" 
                    Background="Transparent" 
                    CornerRadius="8" Padding="15" 
                    Margin="10,20,10,0">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center">
                    <Button x:Name="btnClasificarManual" 
                            Content="Clasificación Manual" 
                            Foreground="White"
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Click="btnClasificacionManual_Click"/>
                    <Button x:Name="btnGuardar"
                            Content="Guardar Registro" 
                            Foreground="White"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>