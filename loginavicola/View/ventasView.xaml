<UserControl x:Class="loginavicola.View.ventasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:loginavicola.View"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Estilo para las tarjetas de estadísticas -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botones -->
        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45a049"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para el botón del modal -->
        <Style x:Key="ModalButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ModalComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Contenido Principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30">

                <!-- Tarjetas de Estadísticas -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Entregas -->
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" 
                            Background="#5BC0BE">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Total Entregas" 
                                          FontSize="12" 
                                          Foreground="White" 
                                          Opacity="0.9"/>
                                <TextBlock Text="{Binding TotalEntregas, FallbackValue=0}" 
                                          FontSize="36" 
                                          FontWeight="Bold" 
                                          Foreground="White"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" 
                                      Text="📦" 
                                       Foreground="white"
                                      FontSize="40" 
                                      VerticalAlignment="Center"
                                      Opacity="0.7"/>
                        </Grid>
                    </Border>

                    <!-- Pendientes -->
                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" 
                            Background="#4CAF50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Pendientes" 
                                          FontSize="12" 
                                          Foreground="White" 
                                          Opacity="0.9"/>
                                <TextBlock Text="{Binding Pendientes, FallbackValue=0}" 
                                          FontSize="36" 
                                          FontWeight="Bold" 
                                          Foreground="White"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" 
                                      Text="🕐" 
                                      Foreground="White"
                                      FontSize="40" 
                                      VerticalAlignment="Center"
                                      Opacity="0.7"/>
                        </Grid>
                    </Border>

                    <!-- En Tránsito -->
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" 
                            Background="#9C59B6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="En Tránsito" 
                                          FontSize="12" 
                                          Foreground="White" 
                                          Opacity="0.9"/>
                                <TextBlock Text="{Binding EnTransito, FallbackValue=0}" 
                                          FontSize="36" 
                                          FontWeight="Bold" 
                                          Foreground="White"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" 
                                      Text="📦" 
                                      FontSize="40" 
                                      Foreground="White"
                                      VerticalAlignment="Center"
                                      Opacity="0.7"/>
                        </Grid>
                    </Border>

                    <!-- Entregadas -->
                    <Border Grid.Column="3" Style="{StaticResource StatCardStyle}" 
                            Background="#FDD835">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Entregadas" 
                                          FontSize="12" 
                                          Foreground="White" 
                                          Opacity="0.9"/>
                                <TextBlock Text="{Binding Entregadas, FallbackValue=0}" 
                                          FontSize="36" 
                                          FontWeight="Bold" 
                                          Foreground="White"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" 
                                      Text="✓" 
                                      FontSize="40"
                                      Foreground="White"
                                      VerticalAlignment="Center"
                                      Opacity="0.7"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Barra de búsqueda y botón -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" 
                            Background="White" 
                            CornerRadius="8" 
                            Padding="5" 
                            Margin="0,0,15,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🔍" 
                                      FontSize="16" 
                                      VerticalAlignment="Center" 
                                      Margin="10,0"/>

                            <TextBox Grid.Column="1" 
                                    Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                    Padding="10,8"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    VerticalContentAlignment="Center"
                                    FontSize="13">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="0"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" 
                            Content="REGISTRAR ENTREGA" 
                            Command="{Binding AbrirModalCommand}"
                            Style="{StaticResource GreenButtonStyle}"/>
                </Grid>

                <!-- Tabla de Historial de ventas -->
                <Border Background="White" 
                        CornerRadius="12" 
                        Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" 
                                        ShadowDepth="2" 
                                        Opacity="0.1" 
                                        Color="#000000"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" 
                                  Text="Historial de ventas" 
                                  FontSize="16" 
                                  FontWeight="SemiBold" 
                                  Foreground="#333333"
                                  Margin="0,0,0,15"/>

                        <DataGrid Grid.Row="1" 
                                 ItemsSource="{Binding ListaVentas}" 
                                 AutoGenerateColumns="False"
                                 CanUserAddRows="False" 
                                 IsReadOnly="True"
                                 HeadersVisibility="Column"
                                 GridLinesVisibility="Horizontal"
                                 HorizontalGridLinesBrush="#F0F0F0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 RowBackground="White"
                                 AlternatingRowBackground="#FAFAFA"
                                 RowHeight="45"
                                 MinHeight="400">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID venta" Binding="{Binding IdVenta}" Width="80"/>
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="150"/>
                                <DataGridTextColumn Header="Tipo de venta" Binding="{Binding TipoVenta}" Width="120"/>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="100"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
                                <DataGridTextColumn Header="Costo Total" Binding="{Binding Total, StringFormat=C}" Width="100"/>

                                <!-- Columna de Estado con color -->
                                <DataGridTemplateColumn Header="Estado" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FDD835"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Estado}" Value="Pendiente">
                                                                <Setter Property="Background" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Estado}" Value="En Tránsito">
                                                                <Setter Property="Background" Value="#9C59B6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Estado}" Value="Entregado">
                                                                <Setter Property="Background" Value="#FDD835"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Estado}" 
                                                           Foreground="White" 
                                                           FontWeight="SemiBold"
                                                           FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Columna de Acciones -->
                                <DataGridTemplateColumn Header="Acciones" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <!-- Botón Editar -->
                                                <Button Content="✏️" 
                                                        Command="{Binding DataContext.EditarVentaCommand, 
                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Editar"
                                                        Margin="2"
                                                        Padding="8,4"
                                                        Background="#2196F3"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="4"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Botón Eliminar -->
                                                <Button Content="🗑️" 
                                                        Command="{Binding DataContext.EliminarVentaCommand, 
                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Eliminar"
                                                        Margin="2"
                                                        Padding="8,4"
                                                        Background="#F44336"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Modal de Registro -->
        <Grid x:Name="ModalOverlay" 
              Background="#80000000"
              Visibility="{Binding MostrarModal, Converter={StaticResource BoolToVis}}">

            <Border Background="White" 
                    CornerRadius="12" 
                    MaxWidth="500" 
                    MaxHeight="650"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Padding="0">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" 
                                    ShadowDepth="5" 
                                    Opacity="0.5" 
                                    Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header del Modal -->
                    <Grid Grid.Row="0" Background="#4CAF50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                  Text="Registro de Entregas" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="White" 
                                  Margin="20,15"
                                  VerticalAlignment="Center"/>

                        <Button Grid.Column="1" 
                               Content="✕" 
                               Command="{Binding CerrarModalCommand}"
                               Background="Transparent"
                               Foreground="White"
                               BorderThickness="0"
                               FontSize="20"
                               Padding="15,10"
                               Cursor="Hand"
                               ToolTip="Cerrar"/>
                    </Grid>

                    <!-- Contenido del Modal -->
                    <ScrollViewer Grid.Row="1" 
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="30,20"
                                 Margin="0,10">
                        <StackPanel>

                            <!-- Fecha -->
                            <TextBlock Text="Fecha" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Foreground="#666"
                                      Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding VentaActual.Fecha}"
                                       Padding="12,10"
                                       BorderBrush="#DDDDDD"
                                       Margin="0,0,0,15"/>

                            <!-- Tipo de venta -->
                            <TextBlock Text="Tipo de venta" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Foreground="#666"
                                      Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding TiposVenta}" 
                                     SelectedItem="{Binding VentaActual.TipoVenta}"
                                     Style="{StaticResource ModalComboBoxStyle}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Padding" Value="10,8"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <!-- Estado -->
                            <TextBlock Text="Estado" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Foreground="#666"
                                      Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Estados}" 
                                     SelectedItem="{Binding VentaActual.Estado}"
                                     Style="{StaticResource ModalComboBoxStyle}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Padding" Value="10,8"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <!-- Quien recibe -->
                            <TextBlock Text="Quien recibe" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Foreground="#666"
                                      Margin="0,0,0,5"/>
                            <TextBox Text="{Binding VentaActual.Cliente, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource ModalTextBoxStyle}"/>

                            <!-- Cantidad -->
                            <TextBlock Text="Cantidad" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Foreground="#666"
                                      Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CantidadProducto, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource ModalTextBoxStyle}"/>

                            <!-- Observaciones -->
                            <TextBlock Text="Observaciones" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Foreground="#666"
                                      Margin="0,0,0,5"/>
                            <TextBox Text="{Binding VentaActual.Observaciones, UpdateSourceTrigger=PropertyChanged}"
                                    Height="80"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    VerticalScrollBarVisibility="Auto"
                                    Padding="12,10"
                                    BorderBrush="#DDDDDD"
                                    BorderThickness="1"
                                    Margin="0,0,0,15"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer con botones -->
                    <Border Grid.Row="2" 
                           BorderThickness="0,1,0,0" 
                           BorderBrush="#E0E0E0" 
                           Padding="30,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" 
                                   Content="GUARDAR"
                                   Command="{Binding RegistrarCommand}"
                                   Style="{StaticResource ModalButtonStyle}"
                                   Background="#4CAF50"
                                   Foreground="White"/>

                            <Button Grid.Column="2" 
                                   Content="CANCELAR"
                                   Command="{Binding CerrarModalCommand}"
                                   Style="{StaticResource ModalButtonStyle}"
                                   Background="#BDC3C7"
                                   Foreground="White"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>