<Window x:Class="loginavicola.View.Registrarse"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        Height="600" Width="550">

    <Border CornerRadius="12">
        <Border.Background>
            <ImageBrush ImageSource="/loginavicola;component/imagenes/gallinas.jpg">
                <ImageBrush.Opacity>0.60</ImageBrush.Opacity>
            </ImageBrush>
        </Border.Background>

        <Border CornerRadius="10" 
                BorderThickness="1"
                Opacity="0.60">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource winBorderColor1}" Offset="0"/>
                    <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.75"/>
                    <GradientStop Color="{StaticResource winBorderColor3}" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Color="{StaticResource primaryBackColor1}" Offset="0"/>
                    <GradientStop Color="#FF000000" Offset="0.75"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BARRA SUPERIOR -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="5"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="REGISTRO DE USUARIO"
                               Foreground="DarkGray"
                               FontSize="10"
                               FontFamily="Arial"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>

                    <!-- Minimize -->
                    <Button x:Name="btnMinimize"
                            BorderThickness="0"
                            Content="-"
                            Foreground="White"
                            FontSize="26"
                            FontFamily="Arial"
                            Cursor="Hand"
                            Grid.Column="1"
                            Click="btnMinimize_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#28AEED"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="Blue"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Width="18" Height="18" CornerRadius="9"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,-6,0,0"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Cerrar -->
                    <Button x:Name="btnCloseRegistro"
                            BorderThickness="0"
                            Content="X"
                            Foreground="White"
                            FontSize="12"
                            FontFamily="Arial"
                            Cursor="Hand"
                            Grid.Column="2"
                            Click="btnCloseRegistro_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#DA34"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="Red"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Width="18" Height="18"
                                        CornerRadius="9"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- PANEL CENTRAL -->
                <Border Width="340"
                        Background="#4DFFFFFF"
                        CornerRadius="20"
                        Margin="0,15,0,15"
                        Grid.Row="1"
                        HorizontalAlignment="Center">

                    <StackPanel Orientation="Vertical" Margin="0,10">

                        <!-- Logo -->
                        <Image Source="/imagenes/logo-sena.png"
                               Width="100" Height="100"
                               Margin="0,10,0,5"/>

                        <TextBlock Text="Unidad Avícola Yamboró"
                                   Foreground="White"
                                   FontSize="19"
                                   FontWeight="Medium"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Únete a nuestra unidad avícola de Yamboró"
                                   Foreground="White"
                                   FontSize="15"
                                   FontFamily="Arial"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="10,5,10,0"/>

                        <!-- Usuario -->
                        <TextBlock Text="Nombre usuario"
                                   Foreground="White"
                                   FontSize="12"
                                   FontFamily="Arial"
                                   Margin="10,25,0,0"/>

                        <TextBox x:Name="txtUser"
                                 FontSize="13"
                                 FontFamily="Arial"
                                 Foreground="White"
                                 CaretBrush="White"
                                 BorderBrush="White"
                                 BorderThickness="0,0,0,1"
                                 Height="28"
                                 VerticalContentAlignment="Center"
                                 Margin="10,5,20,0"
                                 Padding="29,0,0,0">
                            <TextBox.Background>
                                <ImageBrush ImageSource="/imagenes/user_icon.png"
                                            Stretch="Uniform"
                                            AlignmentX="Left"/>
                            </TextBox.Background>
                        </TextBox>

                        <!-- Contraseña -->
                        <TextBlock Text="Contraseña"
                                   Foreground="White"
                                   FontSize="12"
                                   FontFamily="Arial"
                                   Margin="10,25,0,0"/>

                        <PasswordBox x:Name="txtPassword"
                                     FontSize="13"
                                     FontFamily="Arial"
                                     Foreground="White"
                                     CaretBrush="White"
                                     BorderBrush="White"
                                     BorderThickness="0,0,0,1"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     Margin="10,5,20,0"
                                     Padding="29,0,0,0">
                            <PasswordBox.Background>
                                <ImageBrush ImageSource="/imagenes/user_icon.png"
                                            Stretch="Uniform"
                                            AlignmentX="Left"/>
                            </PasswordBox.Background>
                        </PasswordBox>

                        <!-- Confirmar contraseña -->
                        <TextBlock Text="Confirmar contraseña"
                                   Foreground="White"
                                   FontSize="12"
                                   FontFamily="Arial"
                                   Margin="10,25,0,0"/>

                        <PasswordBox x:Name="txtPasswords"
                                     FontSize="13"
                                     FontFamily="Arial"
                                     Foreground="White"
                                     CaretBrush="White"
                                     BorderBrush="White"
                                     BorderThickness="0,0,0,1"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     Margin="10,5,20,0"
                                     Padding="29,0,0,0">
                            <PasswordBox.Background>
                                <ImageBrush ImageSource="/imagenes/user_icon.png"
                                            Stretch="Uniform"
                                            AlignmentX="Left"/>
                            </PasswordBox.Background>
                        </PasswordBox>

                        <!-- Botón Registrar -->
                        <Button x:Name="btnRegistrar"
                                Content="Registrar usuario"
                                Foreground="White"
                                FontSize="12"
                                FontFamily="Arial"
                                Cursor="Hand"
                                BorderThickness="0"
                                Margin="0,40,0,0"
                                Click="BtnRegistrar_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#007B00"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#005E00"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Width="160" Height="40"
                                            CornerRadius="20"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"
                                                          HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
