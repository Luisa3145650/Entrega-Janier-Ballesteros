<UserControl x:Class="loginavicola.View.alimentacionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:loginavicola.View"
             mc:Ignorable="d" 
             d:DesignHeight="1100" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Estilos para las tarjetas superiores -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para el botón verde principal -->
        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✚" FontSize="16" FontWeight="Bold" 
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#27AE60"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para el TextBox de búsqueda -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para botones del modal -->
        <Style x:Key="ModalButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <!-- Contenido Principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30">

                <!-- Tarjetas de Estadísticas -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Consumo del día -->
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" 
                            Background="#17A2B8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                     Text="Consumo estimado por ave" 
                                     FontSize="12" 
                                     Foreground="White" 
                                     Opacity="0.9"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                     Text="120   kg" 
                                     FontSize="36" 
                                     FontWeight="Bold" 
                                     Foreground="White" 
                                     VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="1"
                                     Text="📋" 
                                     FontSize="32" 
                                     Foreground="White"
                                     VerticalAlignment="Bottom"
                                     Opacity="0.7"/>
                        </Grid>
                    </Border>

                    <!-- Consumo semanal -->
                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" 
                            Background="#9C59B6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                     Text="Consumo semanal" 
                                     FontSize="12" 
                                     Foreground="White" 
                                     Opacity="0.9"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                     Text="{Binding ConsumoSemanal, FallbackValue=0      Kg}" 
                                     FontSize="36" 
                                     FontWeight="Bold" 
                                     Foreground="White" 
                                     VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="1"
                                     Text="📊" 
                                     FontSize="32" 
                                       Foreground="White"
                                     VerticalAlignment="Bottom"
                                     Opacity="0.7"/>
                        </Grid>
                    </Border>

                    <!-- Alimento disponible -->
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" 
                            Background="#4CAF50">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                     Text="Alimento disponible" 
                                     FontSize="12" 
                                     Foreground="White" 
                                     Opacity="0.9"/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                     Text="{Binding AlimentoDisponible, FallbackValue=0     Kg}" 
                                     FontSize="36" 
                                     FontWeight="Bold" 
                                     Foreground="White" 
                                     VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="1"
                                     Text="✓" 
                                     FontSize="32" 
                                     Foreground="White"
                                     VerticalAlignment="Bottom"
                                     Opacity="0.7"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Barra de búsqueda y botón -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" 
                            Background="White" 
                            CornerRadius="8" 
                            Padding="5" 
                            Margin="0,0,15,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🔍" 
                                      FontSize="16" 
                                      VerticalAlignment="Center" 
                                      Margin="10,0"/>

                            <TextBox Grid.Column="1" 
                                    Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource SearchBoxStyle}"
                                    x:Name="SearchBox">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="0"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" 
                            Content="REGISTRAR CONSUMO" 
                            Click="BtnRegistrarConsumo_Click"
                            Style="{StaticResource GreenButtonStyle}"/>
                </Grid>

                <!-- Tabla de Historial -->
                <Border Background="White" 
                        CornerRadius="12" 
                        Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" 
                                        ShadowDepth="2" 
                                        Opacity="0.1" 
                                        Color="#000000"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" 
                                  Text="Historial de Consumo" 
                                  FontSize="16" 
                                  FontWeight="SemiBold" 
                                  Foreground="#333333"
                                  Margin="0,0,0,15"/>

                        <DataGrid Grid.Row="1" 
                                 ItemsSource="{Binding Consumos}" 
                                 AutoGenerateColumns="False"
                                 CanUserAddRows="False" 
                                 IsReadOnly="True"
                                 HeadersVisibility="Column"
                                 GridLinesVisibility="Horizontal"
                                 HorizontalGridLinesBrush="#F0F0F0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 RowBackground="White"
                                 AlternatingRowBackground="#FAFAFA"
                                 RowHeight="40"
                                 MinHeight="300">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID consumo/Fecha" 
                                                   Binding="{Binding FechaConsumo, StringFormat=dd/MM/yyyy}" 
                                                   Width="150"/>
                                <DataGridTextColumn Header="Lote" 
                                                   Binding="{Binding IdLoteGallinas}" 
                                                   Width="100"/>
                                <DataGridTextColumn Header="Alimento" 
                                                   Binding="{Binding NombreAlimento}" 
                                                   Width="150"/>
                                <DataGridTextColumn Header="Cantidad" 
                                                   Binding="{Binding CantidadConsumida}" 
                                                   Width="100"/>
                                <DataGridTextColumn Header="Unidad" 
                                                   Binding="{Binding UnidadMedida}" 
                                                   Width="80"/>
                                <DataGridTextColumn Header="Turno" 
                                                   Binding="{Binding Turno}" 
                                                   Width="80"/>
                                <DataGridTextColumn Header="Observaciones" 
                                                   Binding="{Binding Observaciones}" 
                                                   Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Modal de Registro (superpuesto) - OCULTO POR DEFECTO -->
        <Grid x:Name="ModalOverlay" 
              Background="#80000000"
              Visibility="Collapsed"
              IsHitTestVisible="True">

            <Border Background="White" 
                    CornerRadius="12" 
                    MaxWidth="500" 
                    MaxHeight="650"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Padding="0">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" 
                                    ShadowDepth="5" 
                                    Opacity="0.5" 
                                    Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header del Modal -->
                    <Grid Grid.Row="0" Background="#4CAF50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                  Text="Registro Alimentación" 
                                  FontSize="12" 
                                  FontWeight="Bold" 
                                  Foreground="White" 
                                  Margin="20,15"
                                  VerticalAlignment="Center"/>

                        <Button Grid.Column="1" 
                               Content="✕" 
                               Click="BtnCerrarModal_Click"
                               Background="Transparent"
                               Foreground="White"
                               BorderThickness="0"
                               FontSize="18"
                               FontWeight="Bold"
                               Padding="15,10"
                               Cursor="Hand"
                               ToolTip="Cerrar"/>
                    </Grid>

                    <!-- Contenido del Modal -->
                    <ScrollViewer Grid.Row="1" 
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="30,20"
                                 Margin="0,10">
                        <StackPanel>

                            <!-- ID Consumo -->
                            <TextBlock Text="ID consumo" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ConsumoActual.IdConsumo}"
                                    Padding="10,8"
                                    BorderBrush="#DDDDDD"
                                    Margin="0,0,0,15"/>

                            <!-- Fecha -->
                            <TextBlock Text="Fecha" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding ConsumoActual.FechaConsumo}"
                                       Padding="10,8"
                                       BorderBrush="#DDDDDD"
                                       Margin="0,0,0,15"/>

                            <!-- Lote -->
                            <TextBlock Text="Lote" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding LotesActivos}" 
                                     DisplayMemberPath="IdLote"
                                     SelectedValuePath="IdLote"
                                     SelectedValue="{Binding ConsumoActual.IdLoteGallinas}"
                                     Padding="10,8"
                                     BorderBrush="#DDDDDD"
                                     Margin="0,0,0,15">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Padding" Value="10,8"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                          

                            <!-- Alimento -->
                            <TextBlock Text="Alimento" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Margin="0,0,0,5"/>
                            <!-- ✅ REEMPLAZA el ComboBox de alimentos con este -->
                            <ComboBox ItemsSource="{Binding Alimentos}" 
                                      DisplayMemberPath="Nombre"
                                      SelectedItem="{Binding AlimentoSeleccionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Padding="10,8"
                                      BorderBrush="#DDDDDD"
                                      Margin="0,0,0,15">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Padding" Value="10,8"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <!-- Cantidad y Unidad -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Cantidad" 
                                              FontWeight="SemiBold" 
                                              FontSize="11"
                                              Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding ConsumoActual.CantidadConsumida}"
                                            Padding="10,8"
                                            BorderBrush="#DDDDDD"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Unidad" 
                                              FontWeight="SemiBold" 
                                              FontSize="11"
                                              Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding UnidadesMedida}" 
                                             SelectedItem="{Binding ConsumoActual.UnidadMedida}"
                                             Padding="10,8"
                                             BorderBrush="#DDDDDD">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="Padding" Value="10,8"/>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Turno (Opcional según tus necesidades) -->
                            <TextBlock Text="Turno" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Turnos}" 
                                     SelectedItem="{Binding ConsumoActual.Turno}"
                                     Padding="10,8"
                                     BorderBrush="#DDDDDD"
                                     Margin="0,0,0,15">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Padding" Value="10,8"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <!-- Observaciones -->
                            <TextBlock Text="Observaciones" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ConsumoActual.Observaciones}"
                                    Height="80"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    VerticalScrollBarVisibility="Auto"
                                    Padding="10,8"
                                    BorderBrush="#DDDDDD"
                                    Margin="0,0,0,15"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer con botones -->
                    <Border Grid.Row="2" 
                           BorderThickness="0,1,0,0" 
                           BorderBrush="#E0E0E0" 
                           Padding="30,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" 
                                   Content="GUARDAR"
                                   Click="BtnGuardar_Click"
                                   Style="{StaticResource ModalButtonStyle}"
                                   Background="#2ECC71"
                                   Foreground="White"/>

                            <Button Grid.Column="2" 
                                   Content="CANCELAR"
                                   Click="BtnCerrarModal_Click"
                                   Style="{StaticResource ModalButtonStyle}"
                                   Background="#BDC3C7"
                                   Foreground="White"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>