<UserControl x:Class="loginavicola.View.lotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:loginavicola.View"
             mc:Ignorable="d" 
             d:DesignHeight="1300" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Estilos -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="+" FontSize="18" FontWeight="Bold" 
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45a049"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="ModalButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="30,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Contenido Principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">

                <!-- Tarjetas de Estadísticas -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" Background="#17A2B8" Margin="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Total Lotes" 
                                           FontSize="14" 
                                           Foreground="White" 
                                           Opacity="0.9"/>
                                <TextBlock Text="{Binding TotalLotes, FallbackValue=0}" 
                                           FontSize="36" FontWeight="Bold" 
                                           Foreground="White"
                                           Margin="0,5,0,0"/>
                                <TextBlock Text="Registrados en el sistema" 
                                           FontSize="11" 
                                           Foreground="White" 
                                           Opacity="0.8" 
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="📦" Foreground="White" FontSize="40" VerticalAlignment="Bottom" Opacity="0.5" Margin="0,0,5,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" Background="#9C59B6" Margin="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="En Proceso" FontSize="14" 
                                           Foreground="White" 
                                           Opacity="0.9"/>
                                <TextBlock Text="{Binding LotesActivos, FallbackValue=0}" 
                                           FontSize="36" FontWeight="Bold" 
                                           Foreground="White" Margin="0,5,0,0"/>
                                <TextBlock Text="Lotes activos" 
                                           FontSize="11" 
                                           Foreground="White" 
                                           Opacity="0.8" 
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" 
                                       Text="⚙️" 
                                       Foreground="White" 
                                       FontSize="40" 
                                       VerticalAlignment="Bottom" 
                                       Opacity="0.5" 
                                       Margin="0,0,5,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Background="#F39C12" Margin="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cantidad Total" 
                                           FontSize="14" 
                                           Foreground="White"
                                           Opacity="0.9"/>
                                <TextBlock Text="{Binding TotalAves, FallbackValue=0}" 
                                           FontSize="36"
                                           FontWeight="Bold" 
                                           Foreground="White"
                                           Margin="0,5,0,0"/>
                                <TextBlock Text="Aves" 
                                           FontSize="11"
                                           Foreground="White" 
                                           Opacity="0.8"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" 
                                       Text="🐤" 
                                       Foreground="White" 
                                       FontSize="40" 
                                       VerticalAlignment="Bottom" 
                                       Opacity="0.5" 
                                       Margin="0,0,5,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Barra de búsqueda y botón -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" 
                            CornerRadius="8" Padding="5" Margin="0,0,15,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="16" 
                                      VerticalAlignment="Center" Margin="10,0"/>
                            <TextBox Grid.Column="1" 
                                    Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource SearchBoxStyle}"
                                    BorderThickness="0"
                                    VerticalContentAlignment="Center">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="0"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Content="REGISTRAR LOTE" 
                            Command="{Binding AbrirModalCommand}"
                            Style="{StaticResource GreenButtonStyle}"/>
                </Grid>

                <!-- Tabla de Lotes -->
                <Border Background="White" CornerRadius="12" Padding="15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" 
                                        Opacity="0.1" Color="#000000"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Lotes Registrados" 
                                  FontSize="18" FontWeight="SemiBold" 
                                  Margin="0,0,0,15"/>

                        <DataGrid Grid.Row="1" 
                                 ItemsSource="{Binding LotesRegistrados}" 
                                 AutoGenerateColumns="False"
                                 CanUserAddRows="False" 
                                 IsReadOnly="True"
                                 HeadersVisibility="Column"
                                 GridLinesVisibility="None"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 RowBackground="White"
                                 AlternatingRowBackground="#F9F9F9">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                    <Setter Property="Foreground" Value="#333333"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID Lote" Binding="{Binding IdLote}" Width="80"/>
                                <DataGridTextColumn Header="Raza" Binding="{Binding Raza}" Width="110"/>
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadGallinas}" Width="90"/>
                                <DataGridTextColumn Header="Fecha Incorporación" 
                                                   Binding="{Binding FechaIncorporacion, StringFormat=dd/MM/yyyy}" 
                                                   Width="140"/>
                                <DataGridTextColumn Header="Granja Origen" Binding="{Binding GranjaOrigen}" Width="140"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                                <DataGridTextColumn Header="Observaciones" Binding="{Binding Observaciones}" Width="*"/>

                                <DataGridTemplateColumn Header="Acciones" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✏️"
                                                       Command="{Binding DataContext.EditarCommand, 
                                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}"
                                                       Background="#E3F2FD"
                                                       BorderThickness="0"
                                                       Margin="2" Padding="8,4"
                                                       Cursor="Hand"
                                                       ToolTip="Editar lote"/>
                                                <Button Content="🗑️"
                                                       Command="{Binding DataContext.EliminarCommand, 
                                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}"
                                                       Background="#FFEBEE"
                                                       BorderThickness="0"
                                                       Margin="2" Padding="8,4"
                                                       Cursor="Hand"
                                                       ToolTip="Eliminar lote"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Modal de Registro (superpuesto) -->
        <Grid x:Name="ModalOverlay" 
              Background="#80000000"
              Visibility="{Binding MostrarModal, Converter={StaticResource BoolToVis}}">

            <Border Background="White" 
                    CornerRadius="12" 
                    MaxWidth="500" 
                    MaxHeight="600"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Padding="0">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" 
                                    Opacity="0.5" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header del Modal -->
                    <Grid Grid.Row="0" Background="#4CAF50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Registro de Lote" 
                                  FontSize="18" FontWeight="SemiBold" 
                                  Foreground="White" 
                                  Margin="20,15"
                                  VerticalAlignment="Center"/>

                        <Button Grid.Column="1" Content="✕" 
                               Command="{Binding CerrarModalCommand}"
                               Background="Transparent"
                               Foreground="White"
                               BorderThickness="0"
                               FontSize="20"
                               Padding="15,10"
                               Cursor="Hand"
                               ToolTip="Cerrar"/>
                    </Grid>

                    <!-- Contenido del Modal -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                 Padding="20" Margin="0,10">
                        <StackPanel>

                            <!-- ID Lote -->
                            <TextBlock Text="ID Lote" FontWeight="SemiBold" 
                                      Margin="0,0,0,5"/>
                            <TextBox Text="{Binding LoteActual.IdLote, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    IsReadOnly="True"
                                    Background="#F5F5F5"
                                    Padding="10,8"
                                    Margin="0,0,0,15"/>

                            <!-- Fecha de Ingreso -->
                            <TextBlock Text="Fecha ingreso" FontWeight="SemiBold" 
                                      Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding LoteActual.FechaIncorporacion, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                       Padding="10,8"
                                       Margin="0,0,0,15"/>

                            <!-- Cantidad -->
                            <TextBlock Text="Cantidad" FontWeight="SemiBold" 
                                      Margin="0,0,0,5"/>
                            <TextBox Text="{Binding LoteActual.CantidadGallinas, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Padding="10,8"
                                     Margin="0,0,0,15"/>

                            <!-- Raza -->
                            <TextBlock Text="Raza" FontWeight="SemiBold" 
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding LoteActual.Raza, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,8"
                                     Margin="0,0,0,15"
                                     ToolTip="Ingrese la raza de las gallinas"/>

                            <!-- Granja Origen -->
                            <TextBlock Text="Granja Origen" FontWeight="SemiBold" 
                                       Margin="0,0,0,5"/>
                            <TextBox Text="{Binding LoteActual.GranjaOrigen, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Padding="10,8"
                                     Margin="0,0,0,15"/>

                            <!-- Estado óptimo -->
                            <TextBlock Text="Estado óptimo" FontWeight="SemiBold" 
                                      Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding EstadosDisponibles}" 
                                     SelectedItem="{Binding LoteActual.Estado, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Padding="10,8"
                                     Margin="0,0,0,15"/>

                            <!-- Observaciones -->
                            <TextBlock Text="Observaciones" FontWeight="SemiBold" 
                                      Margin="0,0,0,5"/>
                            <TextBox Text="{Binding LoteActual.Observaciones, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Height="80"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="10,8"
                                     Margin="0,0,0,15"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer con botones -->
                    <Border Grid.Row="2" BorderThickness="0,1,0,0" 
                           BorderBrush="#E0E0E0" Padding="20,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="GUARDAR"
                                   Command="{Binding RegistrarCommand}"
                                   Style="{StaticResource ModalButtonStyle}"
                                   Background="#4CAF50"
                                   Foreground="White"
                                   Margin="0,0,5,0"/>

                            <Button Grid.Column="1" Content="CANCELAR"
                                   Command="{Binding CerrarModalCommand}"
                                   Style="{StaticResource ModalButtonStyle}"
                                   Background="#E0E0E0"
                                   Foreground="#333333"
                                   Margin="5,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>