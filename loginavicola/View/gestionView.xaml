<UserControl x:Class="loginavicola.View.gestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:loginavicola.View"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Estilos para las tarjetas de usuario -->
        <Style x:Key="UserCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="200"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para el botón verde principal -->
        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2ECC71"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✚" FontSize="16" FontWeight="Bold" 
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter HorizontalAlignment="Center" 
                                                VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#27AE60"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para botones de las tarjetas -->
        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4CAF50"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilos del modal -->
        <Style x:Key="ModalButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="30,12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <!-- Estilo para PasswordBox -->
        <Style x:Key="ModalPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <!-- Estilo para los iconos de permisos -->
        <Style x:Key="PermissionItemStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <!-- Contenido Principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30">

                <!-- Botón para agregar usuario -->
                <Grid Margin="0,0,0,30">
                    <Button Content="AGREGAR USUARIO" 
                            x:Name="BtnAgregarUsuario"
                            Click="BtnAgregarUsuario_Click"
                            Style="{StaticResource GreenButtonStyle}"
                            HorizontalAlignment="Right"/>
                </Grid>

                <!-- Tarjetas de Usuarios -->
                <Border Background="Transparent" 
                        CornerRadius="12" 
                        Padding="20"
                        MinHeight="600">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" 
                                        ShadowDepth="2" 
                                        Opacity="0.1" 
                                        Color="White"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Usuarios del Sistema" 
                                  FontSize="18" 
                                  FontWeight="SemiBold" 
                                  Foreground="White"
                                  Margin="0,0,0,20"/>

                        <!-- Grid de usuarios -->
                        <ItemsControl ItemsSource="{Binding Usuarios}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource UserCardStyle}">
                                        <StackPanel>
                                            <!-- Avatar -->
                                            <Border Width="50" Height="50" 
                                                   CornerRadius="35" 
                                                   Background="#E8F5E9"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,15">
                                                <TextBlock Text="👤" 
                                                          FontSize="36" 
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Nombre del usuario -->
                                            <TextBlock Text="{Binding NombreCompleto}" 
                                                      FontSize="14" 
                                                      FontWeight="Bold"
                                                      Foreground="#333333"
                                                      TextAlignment="Center"
                                                      TextWrapping="Wrap"
                                                      Margin="0,0,0,5"/>

                                            <!-- Rol -->
                                            <TextBlock Text="{Binding Rol}" 
                                                      FontSize="11" 
                                                      Foreground="#666666"
                                                      TextAlignment="Center"
                                                      Margin="0,0,0,0"/>

                                            <!-- Botón de permisos -->
                                            <Button Content="Gestionar Permisos"
                                                   Style="{StaticResource CardButtonStyle}"
                                                   Click="BtnGestionarPermisos_Click"
                                                   Tag="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Modal de Registro Usuario -->
        <Grid x:Name="ModalRegistroOverlay" 
              Background="#80000000"
              Visibility="Collapsed"
              IsHitTestVisible="True">

            <Border Background="White" 
                    CornerRadius="12" 
                    MaxWidth="450" 
                    MaxHeight="650"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Padding="0">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" 
                                    ShadowDepth="5" 
                                    Opacity="0.5" 
                                    Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header del Modal -->
                    <Grid Grid.Row="0" Background="#2ECC71">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                  Text="Registro Usuario" 
                                  FontSize="16" 
                                  FontWeight="Bold" 
                                  Foreground="White" 
                                  Margin="20,15"
                                  VerticalAlignment="Center"/>

                        <Button Grid.Column="1" 
                               Content="✕" 
                               x:Name="BtnCerrarModalRegistro"
                               Click="BtnCerrarModalRegistro_Click"
                               Background="Transparent"
                               Foreground="White"
                               BorderThickness="0"
                               FontSize="18"
                               FontWeight="Bold"
                               Padding="15,10"
                               Cursor="Hand"
                               ToolTip="Cerrar"/>
                    </Grid>

                    <!-- Contenido del Modal -->
                    <ScrollViewer Grid.Row="1" 
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="30,20"
                                 Margin="0,10">
                        <StackPanel>

                            <!-- Nombres -->
                            <TextBlock Text="nombres" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Margin="0,0,0,5"/>
                            <TextBox Text="{Binding UsuarioActual.Nombres}"
                                    Style="{StaticResource ModalTextBoxStyle}"/>

                            <!-- Apellidos -->
                            <TextBlock Text="Apellidos" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Margin="0,0,0,5"/>
                            <TextBox Text="{Binding UsuarioActual.Apellidos}"
                                    Style="{StaticResource ModalTextBoxStyle}"/>

                            <!-- Documento -->
                            <TextBlock Text="Documento" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Margin="0,0,0,5"/>
                            <TextBox Text="{Binding UsuarioActual.Documento}"
                                    Style="{StaticResource ModalTextBoxStyle}"/>

                            <!-- Teléfono -->
                            <TextBlock Text="Teléfono" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Margin="0,0,0,5"/>
                            <TextBox Text="{Binding UsuarioActual.Telefono}"
                                    Style="{StaticResource ModalTextBoxStyle}"/>

                            <!-- Dirección -->
                            <TextBlock Text="Dirección" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Margin="0,0,0,5"/>
                            <TextBox Text="{Binding UsuarioActual.Direccion}"
                                    Style="{StaticResource ModalTextBoxStyle}"/>

                            <!-- Email -->
                            <TextBlock Text="Email" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Margin="0,0,0,5"/>
                            <TextBox Text="{Binding UsuarioActual.Email}"
                                    Style="{StaticResource ModalTextBoxStyle}"/>

                            <!-- Contraseña -->
                            <TextBlock Text="Contraseña" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Margin="0,0,0,5"/>
                            <PasswordBox x:Name="PasswordBox"
                                        Style="{StaticResource ModalPasswordBoxStyle}"/>

                            <!-- Confirmar Contraseña -->
                            <TextBlock Text="Confirmar Contraseña" 
                                      FontWeight="SemiBold" 
                                      FontSize="11"
                                      Margin="0,0,0,5"/>
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                        Style="{StaticResource ModalPasswordBoxStyle}"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer con botones -->
                    <Border Grid.Row="2" 
                           BorderThickness="0,1,0,0" 
                           BorderBrush="#E0E0E0" 
                           Padding="30,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" 
                                   Content="GUARDAR"
                                   x:Name="BtnGuardarUsuario"
                                   Click="BtnGuardarUsuario_Click"
                                   Style="{StaticResource ModalButtonStyle}"
                                   Background="#2ECC71"
                                   Foreground="White"/>

                            <Button Grid.Column="2" 
                                   Content="CANCELAR"
                                   x:Name="BtnCancelarRegistro"
                                   Click="BtnCerrarModalRegistro_Click"
                                   Style="{StaticResource ModalButtonStyle}"
                                   Background="#BDC3C7"
                                   Foreground="White"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Modal de Gestión de Permisos -->
        <Grid x:Name="ModalPermisosOverlay" 
              Background="#80000000"
              Visibility="Collapsed"
              IsHitTestVisible="True">

            <Border Background="White" 
                    CornerRadius="12" 
                    MaxWidth="400" 
                    MaxHeight="600"
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Padding="0">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" 
                                    ShadowDepth="5" 
                                    Opacity="0.5" 
                                    Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header del Modal -->
                    <Grid Grid.Row="0" Background="#2ECC71">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                  Text="Gestión de permisos" 
                                  FontSize="16" 
                                  FontWeight="Bold" 
                                  Foreground="White" 
                                  Margin="20,15"
                                  VerticalAlignment="Center"/>

                        <Button Grid.Column="1" 
                               Content="✕" 
                               x:Name="BtnCerrarModalPermisos"
                               Click="BtnCerrarModalPermisos_Click"
                               Background="Transparent"
                               Foreground="White"
                               BorderThickness="0"
                               FontSize="18"
                               FontWeight="Bold"
                               Padding="15,10"
                               Cursor="Hand"
                               ToolTip="Cerrar"/>
                    </Grid>

                    <!-- Contenido del Modal -->
                    <ScrollViewer Grid.Row="1" 
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="25,20">
                        <StackPanel>

                            <!-- Inicio -->
                            <Border Style="{StaticResource PermissionItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="🏠" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Inicio" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding PermisoInicio}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Lotes -->
                            <Border Style="{StaticResource PermissionItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="📋" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Lotes" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding PermisoLotes}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Producción -->
                            <Border Style="{StaticResource PermissionItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="🥚" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Producción" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding PermisoProduccion}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Alimentación -->
                            <Border Style="{StaticResource PermissionItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="🌾" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Alimentación" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding PermisoAlimentacion}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Entregas -->
                            <Border Style="{StaticResource PermissionItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="📦" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Entregas" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding PermisoEntregas}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Diagnóstico -->
                            <Border Style="{StaticResource PermissionItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="🩺" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Diagnóstico" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding PermisoDiagnostico}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Inventario -->
                            <Border Style="{StaticResource PermissionItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="📊" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Inventario" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding PermisoInventario}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Gestión de usuarios -->
                            <Border Style="{StaticResource PermissionItemStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="👥" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="Gestión de usuarios" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding PermisoGestionUsuarios}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer con botones -->
                    <Border Grid.Row="2" 
                           BorderThickness="0,1,0,0" 
                           BorderBrush="#E0E0E0" 
                           Padding="30,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" 
                                   Content="GUARDAR"
                                   x:Name="BtnGuardarPermisos"
                                   Click="BtnGuardarPermisos_Click"
                                   Style="{StaticResource ModalButtonStyle}"
                                   Background="#2ECC71"
                                   Foreground="White"/>

                            <Button Grid.Column="2" 
                                   Content="CANCELAR"
                                   x:Name="BtnCancelarPermisos"
                                   Click="BtnCerrarModalPermisos_Click"
                                   Style="{StaticResource ModalButtonStyle}"
                                   Background="#BDC3C7"
                                   Foreground="White"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>