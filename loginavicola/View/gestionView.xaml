<UserControl x:Class="loginavicola.View.gestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:loginavicola.View"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100"
             Background="#EBEFF5">
    <!-- Fondo más oscuro para que resalten las tarjetas -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Gradientes Orgánicos Muy Vivos -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00B" Offset="0.0"/>
            <!-- Azul Cyan Enérgico -->
            <GradientStop Color="#10B981" Offset="1.0"/>
            <!-- Verde Esmeralda -->
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryHoverGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00F5D4" Offset="0.0"/>
            <GradientStop Color="#059669" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Tarjeta con Sombreado Intenso y Profundo -->
        <Style x:Key="PremiumUserCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20,24,20,20"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="260"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <!-- Sombra Intensa Base -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.14" Color="#0F172A"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Efecto cuando el mouse pasa por encima: Flotado Máximo -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#10B981"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="35" ShadowDepth="12" Opacity="0.25" Color="#10B981"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón de Acción Principal Vibrante -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Green"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3" Color="#10B981"/>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="＋" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Green"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Entradas de Formulario Premium -->
        <Style x:Key="ModernInputField" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="Green"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switches con Colores Fuertes -->
        <Style x:Key="ModernToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid x:Name="ToggleTrack" Width="44" Height="24" Margin="0,0,10,0">
                                <Border Background="#CBD5E1" CornerRadius="12" x:Name="TrackBorder"/>
                                <Ellipse x:Name="Thumb" Fill="White" Width="18" Height="18" HorizontalAlignment="Left" Margin="3,0" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TrackBorder" Property="Background" Value="#10B981"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Vista Principal / Dashboard de Gestión -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="40,30">

                <!-- Encabezado de la Sección -->
                <Grid Margin="0,0,0,35">
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="Control de Personal" FontSize="28" FontWeight="Black" Foreground="#0F172A"/>
                        <TextBlock Text="Administra accesos, roles y permisos de la Unidad Avícola." FontSize="14" Foreground="#475569" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Content="NUEVO USUARIO" 
                            x:Name="BtnAgregarUsuario"
                            Click="BtnAgregarUsuario_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Grid Contenedor de Tarjetas -->
                <ItemsControl ItemsSource="{Binding Usuarios}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PremiumUserCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Avatar Ilustrativo con Fondo Llamativo -->
                                    <Border Grid.Row="0" Width="70" Height="70" CornerRadius="35" Background="#D8F3DC" HorizontalAlignment="Center">
                                        <TextBlock Text="👷" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Detalles del Perfil -->
                                    <StackPanel Grid.Row="1" Margin="0,16,0,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding NombreCompleto}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                                        <!-- Badge de Rol Enérgico y Colorido -->
                                        <Border CornerRadius="12" Padding="12,5" Margin="0,10,0,0" HorizontalAlignment="Center" Background="#00B4D8">
                                            <TextBlock Text="{Binding Rol}" FontSize="11" FontWeight="Black" Foreground="White"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Botón de Configuración con Bordes Fuertes -->
                                    <Button Grid.Row="2" Content="Ajustes de Permisos" 
                                            Click="BtnGestionarPermisos_Click"
                                            Tag="{Binding}"
                                            Height="38" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Setter Property="Foreground" Value="#1E293B"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#10B981"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#10B981"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ========================================== -->
        <!-- MODAL: REGISTRO / EDICIÓN DE USUARIO     -->
        <!-- ========================================== -->
        <Grid x:Name="ModalRegistroOverlay" Background="#660F172A" Visibility="Collapsed">
            <Border Background="White" CornerRadius="20" Width="480" MaxHeight="720" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="20" Opacity="0.3" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="24,20" Background="#F1F5F9" CornerRadius="20,20,0,0">
                        <Grid>
                            <TextBlock Text="Crear Nuevo Perfil" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Button Content="✕" x:Name="BtnCerrarModalRegistro" Click="BtnCerrarModalRegistro_Click" Background="Transparent" Foreground="#475569" BorderThickness="0" FontSize="18" HorizontalAlignment="Right" Cursor="Hand" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Nombres" FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding UsuarioActual.Nombres}" Style="{StaticResource ModernInputField}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Apellidos" FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding UsuarioActual.Apellidos}" Style="{StaticResource ModernInputField}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Documento de Identidad" FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding UsuarioActual.Documento}" Style="{StaticResource ModernInputField}"/>

                            <TextBlock Text="Número de Teléfono" FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding UsuarioActual.Telefono}" Style="{StaticResource ModernInputField}"/>

                            <TextBlock Text="Dirección de Residencia" FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding UsuarioActual.Direccion}" Style="{StaticResource ModernInputField}"/>

                            <TextBlock Text="Correo Electrónico" FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding UsuarioActual.Email}" Style="{StaticResource ModernInputField}"/>

                            <TextBlock Text="Asignación de Rol" FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                            <ComboBox SelectedValuePath="Content" SelectedValue="{Binding UsuarioActual.Rol, Mode=TwoWay}" Height="40" Margin="0,0,0,16" Padding="10,0">
                                <ComboBoxItem Content="Administrador"/>
                                <ComboBoxItem Content="Aprendiz"/>
                                <ComboBoxItem Content="Visitante"/>
                            </ComboBox>

                            <TextBlock Text="Contraseña del Sistema" FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="PasswordBox" Height="40" Margin="0,0,0,16"/>

                            <TextBlock Text="Confirmar Contraseña" FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="ConfirmPasswordBox" Height="40" Margin="0,0,0,16"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#F1F5F9" Padding="24,18" CornerRadius="0,0,20,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Registrar Usuario" x:Name="BtnGuardarUsuario" Click="BtnGuardarUsuario_Click" Style="{StaticResource ActionButtonStyle}"/>
                            <Button Grid.Column="2" Content="Cancelar" x:Name="BtnCancelarRegistro" Click="BtnCerrarModalRegistro_Click" Background="#CBD5E1" Foreground="#1E293B" BorderThickness="0" FontWeight="Bold">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- MODAL: PANEL DE PERMISOS                  -->
        <!-- ========================================== -->
        <Grid x:Name="ModalPermisosOverlay" Background="#660F172A" Visibility="Collapsed">
            <Border Background="White" CornerRadius="20" Width="520" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="20" Opacity="0.3" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="24,20" Background="#F1F5F9" CornerRadius="20,20,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Configuración de Accesos" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Activa o desactiva los módulos permitidos." FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Content="✕" x:Name="BtnCerrarModalPermisos" Click="BtnCerrarModalPermisos_Click" Background="Transparent" Foreground="#475569" BorderThickness="0" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                        <UniformGrid Columns="2" VerticalAlignment="Top">
                            <!-- Toggle: Inicio -->
                            <Border Background="#F1F5F9" CornerRadius="12" Padding="14,12" Margin="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoInicio}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Inicio" FontWeight="Bold" Foreground="#0F172A" FontSize="13"/>
                                        <TextBlock Text="Panel principal" Foreground="#64748B" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- Toggle: Lotes -->
                            <Border Background="#F1F5F9" CornerRadius="12" Padding="14,12" Margin="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoLotes}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Lotes" FontWeight="Bold" Foreground="#0F172A" FontSize="13"/>
                                        <TextBlock Text="Control de galpones" Foreground="#64748B" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- Toggle: Producción -->
                            <Border Background="#F1F5F9" CornerRadius="12" Padding="14,12" Margin="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoProduccion}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Producción" FontWeight="Bold" Foreground="#0F172A" FontSize="13"/>
                                        <TextBlock Text="Registro de huevos" Foreground="#64748B" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- Toggle: Alimentación -->
                            <Border Background="#F1F5F9" CornerRadius="12" Padding="14,12" Margin="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoAlimentacion}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Alimentación" FontWeight="Bold" Foreground="#0F172A" FontSize="13"/>
                                        <TextBlock Text="Suministro de concentrado" Foreground="#64748B" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- Toggle: Entregas -->
                            <Border Background="#F1F5F9" CornerRadius="12" Padding="14,12" Margin="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoEntregas}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Entregas" FontWeight="Bold" Foreground="#0F172A" FontSize="13"/>
                                        <TextBlock Text="Salida de pedidos" Foreground="#64748B" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- Toggle: Diagnóstico -->
                            <Border Background="#F1F5F9" CornerRadius="12" Padding="14,12" Margin="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoDiagnostico}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Diagnóstico" FontWeight="Bold" Foreground="#0F172A" FontSize="13"/>
                                        <TextBlock Text="Estado sanitario" Foreground="#64748B" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- Toggle: Inventario -->
                            <Border Background="#F1F5F9" CornerRadius="12" Padding="14,12" Margin="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoInventario}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Inventario" FontWeight="Bold" Foreground="#0F172A" FontSize="13"/>
                                        <TextBlock Text="Insumos y stock" Foreground="#64748B" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- Toggle: Gestión Usuarios -->
                            <Border Background="#F1F5F9" CornerRadius="12" Padding="14,12" Margin="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                <CheckBox IsChecked="{Binding PermisoGestionUsuarios}" Style="{StaticResource ModernToggleStyle}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Usuarios" FontWeight="Bold" Foreground="#0F172A" FontSize="13"/>
                                        <TextBlock Text="Asignar credenciales" Foreground="#64748B" FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </UniformGrid>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#F1F5F9" Padding="24,16" CornerRadius="0,0,20,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Aplicar Cambios" x:Name="BtnGuardarPermisos" Click="BtnGuardarPermisos_Click" Style="{StaticResource ActionButtonStyle}"/>
                            <Button Grid.Column="2" Content="Descartar" x:Name="BtnCancelarPermisos" Click="BtnCerrarModalPermisos_Click" Background="#CBD5E1" Foreground="#1E293B" BorderThickness="0" FontWeight="Bold">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>