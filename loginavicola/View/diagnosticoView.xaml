<UserControl x:Class="loginavicola.View.diagnosticoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:loginavicola.View"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             Background="Transparent"
             FontFamily="Segoe UI">
    <!-- Aplica la tipografía limpia a toda la vista -->

    <UserControl.Resources>
        <!-- Estilo actualizado para tarjetas tipo minimalista -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="35"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <!-- Un gris casi blanco para resaltar sobre el fondo blanco del contenedor -->
            <Setter Property="BorderThickness" Value="6,0,0,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#005E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="✚" FontSize="16" FontWeight="Bold" 
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ContentPresenter HorizontalAlignment="Center" 
                                                 VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#004415"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModalButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="30,14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00872E"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModalComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="PageNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- El Grid principal ahora tiene el fondo gris claro del dashboard -->
    <Grid Background="#F1F5F9">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

            <!-- Contenedor Blanco Principal con esquinas redondeadas y sombra -->
            <Border Background="White" 
                    CornerRadius="16" 
                    Margin="25" 
                    Padding="25">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.05" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Fila de Tarjetas (Stats) -->
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" BorderBrush="#17A2B8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TOTAL DIAGNÓSTICOS" FontSize="11" Foreground="#6B7280" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding TotalDiagnosticos, FallbackValue=0}" FontSize="32" FontWeight="Black" Foreground="#1F2937"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" BorderBrush="#9C59B6">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CASOS ACTIVOS" FontSize="11" Foreground="#6B7280" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding CasosActivos, FallbackValue=0}" FontSize="32" FontWeight="Black" Foreground="#1F2937"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" BorderBrush="#4CAF50">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CASOS RESUELTOS" FontSize="11" Foreground="#6B7280" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding CasosResueltos, FallbackValue=0}" FontSize="32" FontWeight="Black" Foreground="#1F2937"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource StatCardStyle}" BorderBrush="#F39C12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="AVES AFECTADAS" FontSize="11" Foreground="#6B7280" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding AvesAfectadas, FallbackValue=0}" FontSize="32" FontWeight="Black" Foreground="#1F2937"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Resto de la vista original -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Buscador modificado con un borde sutil para que resalte en el fondo blanco -->
                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="5" Margin="0,0,15,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBoxStyle}" x:Name="SearchBox"/>
                            </Grid>
                        </Border>

                        <Button Grid.Column="2" Content="REGISTRAR DIAGNÓSTICO" x:Name="BtnRegistrarDiagnostico" Click="BtnRegistrarDiagnostico_Click" Style="{StaticResource GreenButtonStyle}"/>
                    </Grid>

                    <!-- Sección del Historial sin bordes redundantes (ya está dentro del contenedor principal) -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Historial diagnóstico" FontSize="16" FontWeight="SemiBold" Foreground="#333333" Margin="5,0,0,15"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Diagnosticos}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F0F0" BorderThickness="0" Background="Transparent" RowBackground="White" AlternatingRowBackground="#FAFAFA" RowHeight="40" MinHeight="300" ColumnWidth="Auto" HorizontalScrollBarVisibility="Auto">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaDiagnostico, StringFormat=dd/MM/yyyy}" Width="100"/>
                                <DataGridTemplateColumn Header="Estado" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E74C3C"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Estado}" Value="Resuelto">
                                                                <Setter Property="Background" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Estado}" Foreground="White" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="110"/>
                                <DataGridTextColumn Header="Lote" Binding="{Binding IdLote}" Width="70"/>
                                <DataGridTextColumn Header="Cant. aves" Binding="{Binding GallinasAfectadas}" Width="90"/>
                                <DataGridTemplateColumn Header="Descripción" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DiagnosticoMedico}" TextWrapping="Wrap" MaxHeight="60" VerticalAlignment="Center" Margin="10,5"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tratamiento" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Tratamiento}" TextWrapping="Wrap" MaxHeight="60" VerticalAlignment="Center" Margin="10,5"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Medicamento" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NombreMedicamento}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,5" ToolTip="{Binding NombreMedicamento}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Cant. med." Binding="{Binding CantidadMedicamentoUsado}" Width="90"/>
                                <DataGridTextColumn Header="Veterinario" Binding="{Binding Veterinario}" Width="130"/>
                                <DataGridTemplateColumn Header="Observaciones" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Observaciones}" TextWrapping="Wrap" MaxHeight="60" VerticalAlignment="Center" Margin="10,5" ToolTip="{Binding Observaciones}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Acciones" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✓" Command="{Binding DataContext.MarcarComoResueltoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#2ECC71" Foreground="White" BorderThickness="0" Margin="2" Padding="8,4" Cursor="Hand" FontSize="12" ToolTip="Marcar como resuelto">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Estado}" Value="Resuelto">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="↺" Command="{Binding DataContext.ReabrirCasoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#E67E22" Foreground="White" BorderThickness="0" Margin="2" Padding="8,4" Cursor="Hand" FontSize="12" ToolTip="Reabrir caso">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Estado}" Value="Resuelto">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="🗑" Command="{Binding DataContext.EliminarDiagnosticoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#E74C3C" Foreground="White" BorderThickness="0" Margin="2" Padding="8,4" Cursor="Hand" FontSize="12" ToolTip="Eliminar diagnóstico"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="2" Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Mostrar:" Foreground="#666666" VerticalAlignment="Center" FontSize="12" Margin="0,0,5,0"/>
                                <ComboBox Text="{Binding ElementosPorPagina, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="5,3">
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="10" IsSelected="True"/>
                                    <ComboBoxItem Content="20"/>
                                    <ComboBoxItem Content="50"/>
                                </ComboBox>
                                <TextBlock Text="registros" Foreground="#666666" VerticalAlignment="Center" FontSize="12" Margin="5,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Foreground="#666666" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0">
                                    <Run Text="Página "/>
                                    <Run Text="{Binding PaginaActual, FallbackValue=1}" FontWeight="SemiBold" Foreground="#333333"/>
                                    <Run Text=" de "/>
                                    <Run Text="{Binding TotalPaginas, FallbackValue=1}" FontWeight="SemiBold" Foreground="#333333"/>
                                </TextBlock>

                                <Button Content="◀" Command="{Binding PaginaAnteriorCommand}" Style="{StaticResource PageNavButtonStyle}"/>
                                <Button Content="▶" Command="{Binding PaginaSiguienteCommand}" Style="{StaticResource PageNavButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Modal Actualizado con Bordes Redondeados e Inputs Minimalistas -->
        <Grid x:Name="ModalOverlay" Background="#80000000" Visibility="Collapsed" IsHitTestVisible="True">
            <Border Background="White" CornerRadius="16" MaxWidth="550" MaxHeight="700" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Registro de Diagnóstico" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="30,25,20,15" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" x:Name="BtnCerrarModal" Click="BtnCerrarModal_Click" Background="Transparent" Foreground="#64748B" BorderThickness="0" FontSize="16" FontWeight="Bold" Padding="15,10" Margin="15,15,20,0" Cursor="Hand" ToolTip="Cerrar"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,5,30,20" Margin="0,5">
                        <StackPanel>
                            <TextBlock Text="Fecha" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding DiagnosticoActual.FechaDiagnostico}" Padding="10,8" BorderBrush="#E2E8F0" Margin="0,0,0,15"/>

                            <TextBlock Text="Tipo" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding TiposDiagnostico}" SelectedItem="{Binding DiagnosticoActual.Tipo}" Style="{StaticResource ModalComboBoxStyle}"/>

                            <TextBlock Text="Lote" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding LotesActivos}" DisplayMemberPath="IdLote" SelectedValuePath="IdLote" SelectedValue="{Binding DiagnosticoActual.IdLote}" Style="{StaticResource ModalComboBoxStyle}"/>

                            <TextBlock Text="Descripción" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding DiagnosticoActual.DiagnosticoMedico}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModalTextBoxStyle}"/>

                            <TextBlock Text="Tratamiento" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding DiagnosticoActual.Tratamiento}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModalTextBoxStyle}"/>

                            <TextBlock Text="Medicamento" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding MedicamentosDisponibles}" DisplayMemberPath="Nombre" SelectedValuePath="IdItem" SelectedValue="{Binding DiagnosticoActual.IdMedicamento}" Style="{StaticResource ModalComboBoxStyle}"/>

                            <TextBlock Text="Cantidad de medicamento" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding DiagnosticoActual.CantidadMedicamentoUsado}" Style="{StaticResource ModalTextBoxStyle}"/>

                            <TextBlock Text="Cantidad" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding DiagnosticoActual.GallinasAfectadas}" Style="{StaticResource ModalTextBoxStyle}"/>

                            <TextBlock Text="Veterinario" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding DiagnosticoActual.Veterinario}" Style="{StaticResource ModalTextBoxStyle}"/>

                            <TextBlock Text="Observaciones" Foreground="#475569" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding DiagnosticoActual.Observaciones}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModalTextBoxStyle}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderThickness="0" Padding="30,15,30,25">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Guardar" x:Name="BtnGuardar" Click="BtnGuardar_Click" Style="{StaticResource ModalButtonStyle}" Background="#00872E" Foreground="White"/>
                            <Button Grid.Column="2" Content="Cancelar" x:Name="BtnCancelar" Click="BtnCerrarModal_Click" Style="{StaticResource ModalButtonStyle}" Background="#CBD5E1" Foreground="#475569"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>