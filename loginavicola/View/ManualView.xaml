<Window x:Class="loginavicola.View.ManualView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Clasificación Manual" Height="800" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5"
        WindowStyle="None">

    <Window.Resources>
        <!-- Estilo para TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para DatePicker -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Estilo para Label -->
        <Style x:Key="ModernLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- Estilo para botones -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="263*"/>
            <ColumnDefinition Width="157*"/>
        </Grid.ColumnDefinitions>
        <!-- Header -->
        <Grid Height="60" VerticalAlignment="Top" Background="#4CAF50" Grid.ColumnSpan="2">
            <Grid.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.3"/>
            </Grid.Effect>

            <TextBlock Text="Clasificación Manual" 
                       Foreground="White" 
                       FontSize="20" 
                       FontWeight="SemiBold" 
                       VerticalAlignment="Center" 
                       Margin="20,0,50,0"/>

            <!-- Botón cerrar -->
            <Button Content="✕" 
                    Width="40" 
                    Height="40" 
                    HorizontalAlignment="Right" 
                    Margin="0,0,10,0"
                    Background="Transparent" 
                    Foreground="White" 
                    FontSize="20" 
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnCerrar_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="3">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45A049"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- Contenido del formulario -->
        <ScrollViewer Margin="0,60,0,70" VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="2">
            <StackPanel Margin="25,20,25,20">

                <!-- Recolector -->
                <TextBlock Text="Recolector" Style="{StaticResource ModernLabel}"/>
                <TextBox x:Name="txtRecolector" 
                         Style="{StaticResource ModernTextBox}" 
                         Margin="0,0,0,15"/>

                <!-- Fecha -->
                <TextBlock Text="Fecha ingreso" Style="{StaticResource ModernLabel}"/>
                <DatePicker x:Name="dpFecha" 
                           Style="{StaticResource ModernDatePicker}"
                           SelectedDate="{x:Static sys:DateTime.Now}" 
                           Margin="0,0,0,15"/>

                <!-- Categorías de clasificación -->
                <TextBlock Text="Clasificación por peso" 
                          FontSize="14" 
                          FontWeight="SemiBold" 
                          Foreground="#4CAF50" 
                          Margin="0,10,0,15"/>

                <!-- Jumbo -->
                <TextBlock Text="Jumbo >70gr" Style="{StaticResource ModernLabel}"/>
                <TextBox x:Name="txtJumbo" 
                         Style="{StaticResource ModernTextBox}" 
                         Margin="0,0,0,15"
                         Text="0"/>

                <!-- AAA -->
                <TextBlock Text="AAA 67–77gr" Style="{StaticResource ModernLabel}"/>
                <TextBox x:Name="txtAAA" 
                         Style="{StaticResource ModernTextBox}" 
                         Margin="0,0,0,15"
                         Text="0"/>

                <!-- AA -->
                <TextBlock Text="AA 60–66gr" Style="{StaticResource ModernLabel}"/>
                <TextBox x:Name="txtAA" 
                         Style="{StaticResource ModernTextBox}" 
                         Margin="0,0,0,15"
                         Text="0"/>

                <!-- A -->
                <TextBlock Text="A 53–59gr" Style="{StaticResource ModernLabel}"/>
                <TextBox x:Name="txtA" 
                         Style="{StaticResource ModernTextBox}" 
                         Margin="0,0,0,15"
                         Text="0"/>

                <!-- B -->
                <TextBlock Text="B 46–52gr" Style="{StaticResource ModernLabel}"/>
                <TextBox x:Name="txtB" 
                         Style="{StaticResource ModernTextBox}" 
                         Margin="0,0,0,15"
                         Text="0"/>

                <!-- C -->
                <TextBlock Text="C 46gr" Style="{StaticResource ModernLabel}"/>
                <TextBox x:Name="txtC" 
                         Style="{StaticResource ModernTextBox}" 
                         Margin="0,0,0,15"
                         Text="0"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Botones de acción (footer) -->
        <Grid Height="70" 
              VerticalAlignment="Bottom" 
              Background="White" Grid.ColumnSpan="2">
            <Grid.Effect>
                <DropShadowEffect ShadowDepth="-2" BlurRadius="8" Opacity="0.1"/>
            </Grid.Effect>

            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center">

                <Button Content="GUARDAR" 
                        Width="160" 
                        Background="#4CAF50" 
                        Foreground="White" 
                        Margin="5"
                        Style="{StaticResource PrimaryButton}"
                        Click="btnRegistrar_Click"/>

                <Button Content="CANCELAR" 
                        Width="160" 
                        Background="#E0E0E0" 
                        Foreground="#666666" 
                        Margin="5"
                        Style="{StaticResource PrimaryButton}"
                        Click="btnCerrar_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>