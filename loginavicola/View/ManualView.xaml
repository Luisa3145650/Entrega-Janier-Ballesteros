<Window x:Class="loginavicola.View.ManualView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Clasificación Manual"
        WindowState="Maximized" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent" 
        AllowsTransparency="True"
        WindowStyle="None"
        >

    <Window.Resources>
        <!-- Colores de la paleta -->
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="LabelTextBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#E2E8F0"/>

        <!-- Estilo TextBox Redondeado con altura correcta -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo DatePicker adaptado -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Etiquetas de texto superiores -->
        <Style x:Key="ModernLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource LabelTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Botones Redondeados -->
        <!-- Botones Redondeados (Corregido) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Agregamos un pequeño efecto visual al presionar -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Contenedor general que ocupa toda la pantalla -->
    <Grid>
        <!-- DEFINICIÓN DE COLUMNAS CALIBRADA -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <!-- Espacio exacto ocupado por tu barra de navegación verde lateral -->
            <ColumnDefinition Width="*"/>
            <!-- El área de trabajo gris completa -->
        </Grid.ColumnDefinitions>

        <!-- Fondo oscuro translúcido. Solo se dibuja en la columna 1 para respetar tu menú izquierdo -->
        <Border Grid.Column="1" 
                Background="#85000000" 
                CornerRadius="16" 
                Margin="18,96,18,18">
            <!-- Ajustado a 96 arriba para respetar milimétricamente el grosor de tu barra superior de "Producción" -->

            <!-- Tarjeta Blanca Centralizada -->
            <Border Background="White"
                    CornerRadius="20" 
                    Width="460"
                    Height="640"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.25" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="28,24,28,15">
                        <TextBlock Text="Clasificación Manual"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <Button Content="✕"
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                Foreground="#94A3B8"
                                FontSize="18"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="btnCerrar_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Contenido con ScrollViewer Interno Impecable -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0" Margin="28,0,16,0">
                        <StackPanel>

                            <!-- Lote seleccionado (llega ya elegido desde la pantalla de Producción, solo lectura) -->
                            <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="txtLoteInfo" Text="Lote: -" FontSize="14" FontWeight="Bold" Foreground="#166534" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Recolector" Style="{StaticResource ModernLabel}"/>
                            <TextBox x:Name="txtRecolector" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                            <TextBlock Text="Fecha ingreso" Style="{StaticResource ModernLabel}"/>
                            <DatePicker x:Name="dpFecha"
                                        Style="{StaticResource ModernDatePicker}"
                                        SelectedDate="{x:Static sys:DateTime.Now}"
                                        Margin="0,0,0,16"/>

                            <TextBlock Text="Clasificación por peso"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#007F24"
                                       Margin="0,8,0,16"/>

                            <TextBlock Text="Jumbo >70gr" Style="{StaticResource ModernLabel}"/>
                            <TextBox x:Name="txtJumbo" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16" Text="0"/>

                            <TextBlock Text="AAA 67–77gr" Style="{StaticResource ModernLabel}"/>
                            <TextBox x:Name="txtAAA" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16" Text="0"/>

                            <TextBlock Text="AA 60–66gr" Style="{StaticResource ModernLabel}"/>
                            <TextBox x:Name="txtAA" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16" Text="0"/>

                            <TextBlock Text="A 53–59gr" Style="{StaticResource ModernLabel}"/>
                            <TextBox x:Name="txtA" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16" Text="0"/>

                            <TextBlock Text="B 46–52gr" Style="{StaticResource ModernLabel}"/>
                            <TextBox x:Name="txtB" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16" Text="0"/>

                            <TextBlock Text="C &lt; 46gr" Style="{StaticResource ModernLabel}"/>
                            <TextBox x:Name="txtC" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16" Text="0"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Background="White" Margin="28,15,28,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="Guardar"
                                Grid.Column="0"
                                Background="#007F24"
                                Foreground="White"
                                Style="{StaticResource PrimaryButton}"
                                Click="btnRegistrar_Click"/>

                        <Button Content="Cancelar"
                                Grid.Column="2"
                                Background="#D1D5DB"
                                Foreground="#475569"
                                Style="{StaticResource PrimaryButton}"
                                Click="btnCerrar_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
