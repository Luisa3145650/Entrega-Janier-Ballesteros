<UserControl x:Class="loginavicola.View.homeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             x:Name="RootView"
             FontFamily="Segoe UI"
             d:DesignHeight="600" d:DesignWidth="1100">

    <UserControl.Resources>
        <!-- Estilo General para Tarjetas CORREGIDO para dar contraste -->
        <Style x:Key="ColorCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="35,35"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="MinHeight" Value="140"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <!-- Borde sutil para delimitar la tarjeta si el fondo es claro -->
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- Sombra más pronunciada y oscura -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="3" 
                                      Opacity="0.12" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para el Título de las Tarjetas -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Estilo para el Valor Principal Grande -->
        <Style x:Key="BigValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <!-- Estilo para Unidades (e.g., Kg) -->
        <Style x:Key="ValueUnitStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <!-- Estilo para Texto de Alerta -->
        <Style x:Key="AlertTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,20,20,0">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Panel de Control General" 
                           FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="Monitoreo de producción y analíticas de Yamboró." 
                           FontSize="14" Foreground="#6B7280" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
               
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20,24,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ColorCardStyle}">
                <Grid>
                    <Border CornerRadius="4" Background="#FBBF24" Width="6" HorizontalAlignment="Left" Margin="-24,-20,0,-20"/>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="TOTAL GALLINAS" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock x:Name="TotalGallinasValue" Text="{Binding TotalAves, StringFormat={}{0:N0}}" 
                                   Style="{StaticResource BigValueStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource ColorCardStyle}">
                <Grid>
                    <Border CornerRadius="4" Background="#3B82F6" Width="6" HorizontalAlignment="Left" Margin="-24,-20,0,-20"/>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="HUEVOS HOY" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock x:Name="HuevosHoyValue" Text="{Binding TotalHuevosHoy, StringFormat={}{0:N0}}" 
                                   Style="{StaticResource BigValueStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ColorCardStyle}">
                <Grid>
                    <Border CornerRadius="4" Background="#A855F7" Width="6" HorizontalAlignment="Left" Margin="-24,-20,0,-20"/>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="STOCK ALIMENTO" Style="{StaticResource CardTitleStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="AlimentoValue" Text="{Binding TotalAlimento, StringFormat={}{0:N0}}" 
                                       Style="{StaticResource BigValueStyle}"/>
                            <TextBlock Text="Kg" Style="{StaticResource ValueUnitStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource ColorCardStyle}" Background="#FEF2F2">
                <Grid>
                    <Border CornerRadius="4" Background="#EF4444" Width="6" HorizontalAlignment="Left" Margin="-24,-20,0,-20"/>
                    <Grid Margin="12,0,0,0">
                        <StackPanel HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ALERTAS STOCK " Style="{StaticResource CardTitleStyle}" Margin="0,0,4,8"/>
                                <TextBlock Text="(&lt; 15)" Style="{StaticResource AlertTextStyle}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            </StackPanel>
                            <TextBlock x:Name="LotesValue" Text="{Binding TotalLotes}" 
                                       Style="{StaticResource BigValueStyle}" Foreground="#EF4444"/>
                        </StackPanel>
                        <Border Width="40" Height="40" Background="#FEE2E2" CornerRadius="12" 
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-12,-12,0">
                            <TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="20,16,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnAnterior" 
                        Grid.Column="0"
                        Width="45" Height="45"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Cursor="Hand"
                        Click="BtnAnterior_Click"
                        Visibility="Collapsed">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#10B981" CornerRadius="22.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
                                </Border.Effect>
                                <TextBlock Text="◀" FontSize="20" Foreground="White" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,2,0"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Border x:Name="CarruselContainer" 
                        Grid.Column="1"
                        Background="White" 
                        CornerRadius="12" 
                        Padding="30,24"
                        Margin="10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" 
                                          Opacity="0.08" Color="#000000"/>
                    </Border.Effect>

                    <Grid x:Name="CarruselContent">
                        <TextBlock Text="Sección de Gráficas" FontSize="18" FontWeight="Medium" 
                                   Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Button x:Name="btnSiguiente" 
                        Grid.Column="2"
                        Width="45" Height="45"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Cursor="Hand"
                        Click="BtnSiguiente_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#10B981" CornerRadius="22.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
                                </Border.Effect>
                                <TextBlock Text="▶" FontSize="20" Foreground="White" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,20,0,0">
                <Border x:Name="Indicator0" Width="40" Height="6" CornerRadius="3" 
                        Background="#10B981" Margin="6,0" Cursor="Hand"/>
                <Border x:Name="Indicator1" Width="40" Height="6" CornerRadius="3" 
                        Background="#D1D5DB" Margin="6,0" Cursor="Hand"/>
                <Border x:Name="Indicator2" Width="40" Height="6" CornerRadius="3" 
                        Background="#D1D5DB" Margin="6,0" Cursor="Hand"/>
                <Border x:Name="Indicator3" Width="40" Height="6" CornerRadius="3" 
                        Background="#D1D5DB" Margin="6,0" Cursor="Hand"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>